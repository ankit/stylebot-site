---
type Props = { keys: Array<string>; sep?: string };
const { keys, sep = '+' } = Astro.props;

const MAC_KEYS: Record<string, string> = { ctrl: 'cmd', alt: 'option' };
---

<span class="keys">
  {keys.map((key, i) => (
    <>
      {i > 0 && <span class="keys-sep">{sep}</span>}
      <kbd data-mac={MAC_KEYS[key]}>{key}</kbd>
    </>
  ))}
</span>

<script>
  import './mac-keys';
</script>

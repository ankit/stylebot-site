---
import ButtonLink from '@/components/ButtonLink';
import { BROWSERS, STORES } from '@/lib/links';

import { fmt } from '@/i18n';

// With a variant, the link looks like a button.
type Props = {
  index: 0 | 1 | 2 | 3;
  format: 'add' | 'name' | 'reinstall';
  variant?: 'primary' | 'outline';
  size?: 'md' | 'sm';
  class?: string;
};

const { index, format, variant, size, class: className } = Astro.props;
const store = STORES[BROWSERS[index]];
const { t } = Astro.locals;
const template = {
  add: t('Add to {store}'),
  name: '{store}',
  reinstall: t('Reinstall for {store}'),
}[format];
const label = fmt(template, { store: store.name });
---

{variant && (
  <ButtonLink
    href={store.href}
    variant={variant}
    size={size}
    class={className}
    data-store-slot={index}
    data-store-label={template}
  >
    {label}
  </ButtonLink>
)}
{!variant && (
  <a
    href={store.href}
    class={className}
    data-store-slot={index}
    data-store-label={template}
  >
    {label}
  </a>
)}

<script>
  import { BROWSERS, currentBrowser, STORES } from '@/lib/links';

  import { fmt } from '@/i18n/format';

  // Where Stylebot doesn't run, Chrome comes first, as on the built page.
  const current = currentBrowser() ?? 'chrome';
  const order = [current, ...BROWSERS.filter((b) => b !== current)];

  document
    .querySelectorAll<HTMLAnchorElement>('[data-store-slot]')
    .forEach((link) => {
      const store = STORES[order[Number(link.dataset.storeSlot)]];

      link.href = store.href;
      link.textContent = fmt(link.dataset.storeLabel!, { store: store.name });
    });
</script>

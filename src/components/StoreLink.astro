---
import { BROWSERS, STORES } from '../lib/links';
import { fmt, messagesFor } from '../i18n';

type Props = {
  index: 0 | 1 | 2;
  format: 'add' | 'name' | 'reinstall';
  class?: string;
};

const { index, format, class: className } = Astro.props;
const store = STORES[BROWSERS[index]];
const { site: t } = messagesFor(Astro.url);
const template = {
  add: t.store.add,
  name: '{store}',
  reinstall: t.store.reinstall,
}[format];
---

<a
  href={store.href}
  class={className}
  data-store-slot={index}
  data-store-label={template}
>
  {fmt(template, { store: store.name })}
</a>

<script>
  import { fmt } from '../i18n/format';
  import { type Browser, BROWSERS, STORES } from '../lib/links';

  const ua = navigator.userAgent;
  const current: Browser = /Firefox\//.test(ua)
    ? 'firefox'
    : /Edg\//.test(ua)
      ? 'edge'
      : 'chrome';
  const order = [current, ...BROWSERS.filter((b) => b !== current)];

  document
    .querySelectorAll<HTMLAnchorElement>('[data-store-slot]')
    .forEach((link) => {
      const store = STORES[order[Number(link.dataset.storeSlot)]];

      link.href = store.href;
      link.textContent = fmt(link.dataset.storeLabel!, { store: store.name });
    });
</script>

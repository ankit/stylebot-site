---
import ButtonLink from '@/components/ButtonLink';
import { BROWSERS, type Placement, STORES, storeHref } from '@/lib/links';

import { fmt } from '@/i18n';

// With a variant, the link looks like a button.
type Props = {
  index: 0 | 1 | 2 | 3;
  format: 'add' | 'name' | 'reinstall';
  placement: Placement;
  variant?: 'primary' | 'outline';
  size?: 'md' | 'sm';
  class?: string;
};

const {
  index,
  format,
  placement,
  variant,
  size,
  class: className,
} = Astro.props;
const browser = BROWSERS[index];
const store = STORES[browser];
const href = storeHref(browser, placement);
const { t } = Astro.locals;
const template = {
  add: t('Add to {store}'),
  name: '{store}',
  reinstall: t('Reinstall for {store}'),
}[format];
const label = fmt(template, { store: store.name });
---

{variant && (
  <ButtonLink
    href={href}
    variant={variant}
    size={size}
    class={className}
    data-store-slot={index}
    data-store-label={template}
    data-store-placement={placement}
  >
    {label}
  </ButtonLink>
)}
{!variant && (
  <a
    href={href}
    class={className}
    data-store-slot={index}
    data-store-label={template}
    data-store-placement={placement}
  >
    {label}
  </a>
)}

<script>
  import {
    BROWSERS,
    currentBrowser,
    type Placement,
    storeHref,
    STORES,
  } from '@/lib/links';

  import { fmt } from '@/i18n/format';

  // Where Stylebot doesn't run, Chrome comes first, as on the built page.
  const current = currentBrowser() ?? 'chrome';
  const order = [current, ...BROWSERS.filter((b) => b !== current)];

  document
    .querySelectorAll<HTMLAnchorElement>('[data-store-slot]')
    .forEach((link) => {
      const browser = order[Number(link.dataset.storeSlot)];
      const placement = link.dataset.storePlacement as Placement;

      link.href = storeHref(browser, placement);
      link.textContent = fmt(link.dataset.storeLabel!, {
        store: STORES[browser].name,
      });
    });
</script>

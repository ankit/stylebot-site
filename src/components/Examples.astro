---
import { Image, getImage } from 'astro:assets';

import CheckIcon from '@/components/icons/CheckIcon';
import CloseIcon from '@/components/icons/CloseIcon';
import CopyIcon from '@/components/icons/CopyIcon';
import SbIcon from '@/components/icons/SbIcon';

import { LINKS } from '@/lib/links';
import { EXAMPLES, type ExampleSite } from '@/lib/examples';

const { t } = Astro.locals;
const strings = {
  alt: t('{site} restyled with Stylebot: {name}'),
  install: t('Install'),
  installedAs:
    // i18n: {name} is the name of the profile Stylebot added the style as.
    t('Installed as {name}'),
  installFailed: t('Couldn’t install'),
  copy: t('Copy CSS'),
  copied: t('Copied'),
};

const SOURCE_BASE = `${LINKS.siteGithub}/blob/main/src/assets/gallery/`;

/**
 * The custom properties that crop a site's screenshots on phones.
 */
const cropStyle = ({ phoneCrop: { x, y, width } }: ExampleSite) =>
  `--crop-x: ${x}; --crop-y: ${y}; --crop-w: ${width}`;

const sites = await Promise.all(
  EXAMPLES.map(async (site) => ({
    ...site,
    themes: await Promise.all(
      site.themes.map(async (theme) => ({
        ...theme,
        full: (
          await getImage({
            src: theme.image,
            width: theme.image.width,
            format: 'webp',
            quality: 90,
          })
        ).src,
      })),
    ),
  })),
);
---

<section id="examples" class="section" data-strings={JSON.stringify(strings)}>
  <div class="section-inner">
    <div class="section-head">
      <div>
        <h2 class="section-title">{t('Styles to start from')}</h2>
        <p class="section-subtitle">
          {t('Copy one and tweak it, or start from scratch.')}
        </p>
      </div>
    </div>
    <div class="examples-grid">
      {sites.map((site) => (
        <figure
          class="examples-item"
          data-example={site.id}
          data-site={site.url}
          data-active="0"
          style={cropStyle(site)}
        >
          <span class="examples-site">{site.site}</span>
          <div class="examples-shot">
            {site.themes.map((theme, i) => (
              <button
                class="examples-open"
                data-open
                data-theme={i}
                data-full={theme.full}
                hidden={i !== 0}
                aria-label={
                  // i18n: {site} is a website, {name} the name of one of its styles, such as Dracula.
                  t('Enlarge {site}: {name}', {
                    site: site.site,
                    name: theme.name,
                  })
                }
              >
                <Image
                  src={theme.image}
                  widths={[480, 720, 960, 1920]}
                  sizes="(min-width: 1180px) 360px, (min-width: 700px) 45vw, (min-width: 640px) 100vw, 260vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  alt={t('{site} restyled with Stylebot: {name}', {
                    site: site.site,
                    name: theme.name,
                  })}
                />
              </button>
            ))}
            <div class="examples-actions">
              <button
                class="examples-action examples-install"
                data-install
                title={t('Install in Stylebot')}
              >
                <span class="examples-action-idle">
                  <SbIcon size={13} />
                  {t('Install')}
                </span>
                <span class="examples-action-ok">
                  <CheckIcon size={12} />
                  {t('Installed')}
                </span>
              </button>
              <button
                class="examples-action examples-copy"
                data-copy
                title={t('Copy CSS')}
                aria-label={t('Copy CSS')}
              >
                <span class="examples-action-idle">
                  <CopyIcon />
                </span>
                <span class="examples-action-ok">
                  <CheckIcon />
                </span>
              </button>
            </div>
          </div>
          <figcaption class="examples-caption">
            <div class="examples-chips">
              {site.themes.map((theme, i) => (
                <button
                  class="examples-chip"
                  data-chip={i}
                  aria-pressed={i === 0}
                >
                  <span
                    class="examples-dot"
                    style={`background: linear-gradient(135deg, ${theme.colors[0]} 0 50%, ${theme.colors[1]} 50% 100%)`}
                  />
                  <span class="examples-name">{theme.name}</span>
                </button>
              ))}
            </div>
            <p class="examples-hint">
              {
                // i18n: Shown after copying a style's CSS; {site} is a website, such as github.com. "Code" is the editor tab's name in Stylebot; use the extension's own translation.
                t('Paste it into the Code tab on {site}.', { site: site.url })
              }
            </p>
          </figcaption>
          {site.themes.map((theme, i) => (
            <template
              data-theme-data={i}
              data-note={theme.note}
              data-file={theme.file}
              data-source={theme.file && SOURCE_BASE + theme.file}
            >
              {theme.css}
            </template>
          ))}
        </figure>
      ))}
    </div>
  </div>
</section>

<dialog class="lightbox" aria-label={t('Restyled site')}>
  <div class="lightbox-body" data-close>
    <img class="lightbox-img" alt="" />
    <div class="lightbox-bar">
      <span class="lightbox-site" />
      <div class="lightbox-chips" />
      <span class="lightbox-note" hidden />
      <button class="lightbox-install" data-lightbox-install hidden>
        {t('Install')}
      </button>
      <button class="lightbox-copy" data-lightbox-copy>
        {t('Copy CSS')}
      </button>
      {/* eslint-disable-next-line astro/jsx-a11y/anchor-is-valid -- its href is set when a theme with a source file opens */}
      <a
        class="lightbox-source"
        data-lightbox-source
        target="_blank"
        rel="noopener"
        hidden
      >
        {t('View on GitHub')}
      </a>
    </div>
  </div>
  <button class="lightbox-close" data-close aria-label={t('Close')}>
    <CloseIcon strokeWidth={1.6} />
  </button>
</dialog>

<script>
  import { track } from '@/lib/analytics';

  import { fmt } from '@/i18n/format';

  const COPIED_MS = 1600;
  const phone = matchMedia('(max-width: 639px)');
  const INSTALL_TIMEOUT_MS = 5000;
  let resetTimer: ReturnType<typeof setTimeout> | undefined;
  let lightboxItem: HTMLElement | null = null;

  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const lightboxCopy = dialog.querySelector<HTMLButtonElement>(
    '[data-lightbox-copy]',
  )!;
  const lightboxInstall = dialog.querySelector<HTMLButtonElement>(
    '[data-lightbox-install]',
  )!;
  const lightboxSource = dialog.querySelector<HTMLAnchorElement>(
    '[data-lightbox-source]',
  )!;
  const lightboxChips = dialog.querySelector<HTMLElement>('.lightbox-chips')!;
  const examples = document.getElementById('examples')!;
  const strings: Record<
    'alt' | 'install' | 'installedAs' | 'installFailed' | 'copy' | 'copied',
    string
  > = JSON.parse(examples.dataset.strings!);
  const items = [...document.querySelectorAll<HTMLElement>('.examples-item')];
  const installed = new Map<string, string>();
  const failed = new Set<string>();
  const copied = new Set<string>();

  const activeOf = (item: HTMLElement) => Number(item.dataset.active);
  const keyOf = (item: HTMLElement) =>
    `${item.dataset.example}:${activeOf(item)}`;
  const themeData = (item: HTMLElement) =>
    item.querySelector<HTMLTemplateElement>(
      `template[data-theme-data="${activeOf(item)}"]`,
    )!;
  const cssOf = (item: HTMLElement) =>
    themeData(item).content.textContent ?? '';
  const noteOf = (item: HTMLElement) => themeData(item).dataset.note;
  const fileOf = (item: HTMLElement) =>
    themeData(item).dataset.file!.replace(/\.css$/, '');
  const nameOf = (item: HTMLElement) =>
    item.querySelectorAll('.examples-name')[activeOf(item)].textContent ?? '';
  const siteOf = (item: HTMLElement) =>
    item.querySelector('.examples-site')!.textContent ?? '';
  const fullSrc = (item: HTMLElement) =>
    item.querySelector<HTMLButtonElement>(
      `[data-open][data-theme="${activeOf(item)}"]`,
    )!.dataset.full!;

  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const area = document.createElement('textarea');

      area.value = text;
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.appendChild(area);
      area.select();
      document.execCommand('copy');
      area.remove();
    }
  }

  function installLabel(item: HTMLElement) {
    const name = installed.get(keyOf(item));

    if (name) {
      return fmt(strings.installedAs, { name });
    }

    if (failed.has(keyOf(item))) {
      return strings.installFailed;
    }

    return strings.install;
  }

  /**
   * Brings a card's buttons in line with its selected theme: which
   * screenshot shows, whether it has CSS to copy, and what is already done.
   */
  function render(item: HTMLElement) {
    const active = activeOf(item);
    const key = keyOf(item);
    const hasCss = !noteOf(item);

    item.querySelectorAll<HTMLElement>('[data-open]').forEach((el) => {
      el.hidden = Number(el.dataset.theme) !== active;
    });
    item.querySelectorAll<HTMLElement>('[data-chip]').forEach((el) => {
      el.setAttribute(
        'aria-pressed',
        String(Number(el.dataset.chip) === active),
      );
    });
    item.querySelector<HTMLElement>('.examples-actions')!.hidden = !hasCss;
    item.classList.toggle('is-copied', copied.has(key));
    item.classList.toggle('is-installed', installed.has(key));
    item
      .querySelector('[data-copy]')!
      .setAttribute('title', copied.has(key) ? strings.copied : strings.copy);
    item
      .querySelector('[data-install]')!
      .setAttribute('title', installLabel(item));

    if (lightboxItem === item) {
      renderLightbox(item);
    }
  }

  function select(item: HTMLElement, index: number) {
    item.dataset.active = String(index);
    render(item);
  }

  function markCopied(item: HTMLElement) {
    const key = keyOf(item);

    copied.clear();
    copied.add(key);
    items.forEach(render);
    clearTimeout(resetTimer);
    resetTimer = setTimeout(() => {
      copied.delete(key);
      items.forEach(render);
    }, COPIED_MS);
  }

  async function copyItem(item: HTMLElement) {
    await copyText(cssOf(item));
    track('Gallery copy', { theme: fileOf(item) });
    markCopied(item);
  }

  /*
   * Stylebot's content script on this site answers the ping, so the install
   * buttons only show when there's an extension to install into.
   */
  window.addEventListener('message', (e) => {
    if (e.source === window && e.data?.type === 'stylebot:pong') {
      examples.classList.add('can-install');

      if (lightboxItem) {
        renderLightbox(lightboxItem);
      }
    }
  });
  window.postMessage({ type: 'stylebot:ping' }, location.origin);

  /**
   * Asks Stylebot to add the item's css as a new profile for its site, and
   * resolves with the profile's name, or null if it wasn't installed.
   */
  function requestInstall(item: HTMLElement): Promise<string | null> {
    const id = crypto.randomUUID();

    return new Promise((resolve) => {
      const done = (name: string | null) => {
        window.removeEventListener('message', onMessage);
        clearTimeout(timer);
        resolve(name);
      };

      const onMessage = (e: MessageEvent) => {
        if (
          e.source === window &&
          e.data?.type === 'stylebot:installed' &&
          e.data.id === id
        ) {
          done(e.data.profileName ?? null);
        }
      };

      const timer = setTimeout(() => done(null), INSTALL_TIMEOUT_MS);

      window.addEventListener('message', onMessage);
      window.postMessage(
        {
          type: 'stylebot:install',
          id,
          url: item.dataset.site,
          name: nameOf(item),
          css: cssOf(item),
        },
        location.origin,
      );
    });
  }

  async function installItem(item: HTMLElement) {
    const key = keyOf(item);
    const name = await requestInstall(item);

    track('Gallery install', {
      theme: fileOf(item),
      result: name ? 'installed' : 'failed',
    });

    if (name) {
      installed.set(key, name);
      failed.delete(key);
      item.classList.add('is-just-installed');
      setTimeout(() => item.classList.remove('is-just-installed'), COPIED_MS);
    } else {
      failed.add(key);
    }

    render(item);
  }

  /**
   * Fetches the full-size screenshots of each card's selected theme once the
   * section is near the viewport, so opening one shows it immediately.
   */
  const preloaded = new Set<string>();

  function preload(item?: HTMLElement) {
    (item ? [item] : items).forEach((el) => {
      const src = fullSrc(el);

      if (preloaded.has(src)) {
        return;
      }

      preloaded.add(src);
      const img = new Image();

      img.decoding = 'async';
      img.src = src;
    });
  }

  new IntersectionObserver(
    (entries, observer) => {
      if (!entries.some((e) => e.isIntersecting)) {
        return;
      }

      observer.disconnect();
      preload();
    },
    { rootMargin: '600px 0px' },
  ).observe(examples);

  function renderLightbox(item: HTMLElement) {
    const img = dialog.querySelector<HTMLImageElement>('.lightbox-img')!;
    const note = noteOf(item);
    const noteEl = dialog.querySelector<HTMLElement>('.lightbox-note')!;
    const key = keyOf(item);

    img.src = fullSrc(item);
    img.alt = fmt(strings.alt, { site: siteOf(item), name: nameOf(item) });
    dialog.querySelector('.lightbox-site')!.textContent = siteOf(item);
    const refocus = lightboxChips.contains(document.activeElement);

    lightboxChips.replaceChildren(
      ...[...item.querySelectorAll<HTMLElement>('[data-chip]')].map((chip) => {
        const copy = chip.cloneNode(true) as HTMLElement;

        copy.className = 'lightbox-chip';
        copy.querySelector('.examples-dot')!.className = 'lightbox-dot';
        copy.querySelector('.examples-name')!.className = 'lightbox-chip-name';

        return copy;
      }),
    );
    const source = themeData(item).dataset.source;

    lightboxSource.hidden = !source;

    if (source) {
      lightboxSource.href = source;
    }

    if (refocus) {
      lightboxChips
        .querySelectorAll<HTMLElement>('[data-chip]')
        [activeOf(item)]?.focus();
    }

    noteEl.textContent = note ?? '';
    noteEl.hidden = !note;
    lightboxCopy.hidden = !!note;
    lightboxInstall.hidden =
      !!note || !examples.classList.contains('can-install');
    lightboxInstall.textContent = installLabel(item);
    lightboxCopy.textContent = copied.has(key) ? strings.copied : strings.copy;
  }

  function open(item: HTMLElement) {
    // Phones show a readable crop in the card, so there's nothing to enlarge.
    if (phone.matches) {
      return;
    }

    lightboxItem = item;
    preload(item);
    renderLightbox(item);

    if (!dialog.open) {
      dialog.showModal();
    }
  }

  items.forEach((item) => {
    item
      .querySelector('[data-copy]')!
      .addEventListener('click', () => copyItem(item));
    item
      .querySelector('[data-install]')!
      .addEventListener('click', () => installItem(item));
    item.querySelectorAll<HTMLElement>('[data-open]').forEach((el) => {
      el.addEventListener('click', () => open(item));
    });
    item.querySelectorAll<HTMLElement>('[data-chip]').forEach((chip) => {
      chip.addEventListener('click', () =>
        select(item, Number(chip.dataset.chip)),
      );
    });
    render(item);
  });

  lightboxChips.addEventListener('click', (e) => {
    e.stopPropagation();
    const chip = (e.target as HTMLElement).closest<HTMLElement>('[data-chip]');

    if (chip && lightboxItem) {
      select(lightboxItem, Number(chip.dataset.chip));
    }
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && dialog.open) {
      dialog.close();
    }
  });

  dialog.addEventListener('keydown', (e) => {
    if (!lightboxItem || (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight')) {
      return;
    }

    e.preventDefault();
    const count = lightboxItem.querySelectorAll('[data-chip]').length;
    const dir = e.key === 'ArrowRight' ? 1 : -1;

    select(lightboxItem, (activeOf(lightboxItem) + dir + count) % count);
  });

  lightboxInstall.addEventListener('click', (e) => {
    e.stopPropagation();

    if (lightboxItem && !noteOf(lightboxItem)) {
      installItem(lightboxItem);
    }
  });

  lightboxCopy.addEventListener('click', (e) => {
    e.stopPropagation();

    if (lightboxItem && !noteOf(lightboxItem)) {
      copyItem(lightboxItem);
    }
  });

  dialog.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    if (target === dialog || target.closest('[data-close]')) {
      dialog.close();
    }
  });

  dialog.addEventListener('close', () => {
    lightboxItem = null;
  });
</script>

<style>
  .examples-grid {
    display: grid;
    gap: 40px 24px;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }

  .examples-item {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
  }

  .examples-shot {
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-muted);
    box-shadow: var(--shadow-lg);
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .examples-shot:has(.examples-open:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .examples-shot:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-xl);
  }

  .examples-open {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }

  .examples-open:focus-visible {
    outline: none;
  }

  .examples-open img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .examples-open[hidden],
  .examples-actions[hidden] {
    display: none;
  }

  .examples-actions {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 2;
    display: flex;
    gap: 6px;
  }

  .examples-action {
    width: 28px;
    height: 28px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    border: none;
    cursor: pointer;
    backdrop-filter: blur(6px);
    background: rgba(20, 22, 26, 0.45);
    color: #fff;
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition:
      opacity 0.15s,
      transform 0.15s,
      background 0.15s;
  }

  .examples-install {
    display: none;
    width: auto;
    padding: 0 10px 0 8px;
    font: 600 var(--text-xs)/1 var(--font-ui);
  }

  .examples-install span {
    gap: 5px;
    align-items: center;
  }

  .can-install .examples-install {
    display: flex;
  }

  .examples-shot:hover .examples-action,
  .examples-action:focus-visible,
  .is-copied .examples-copy,
  .is-just-installed .examples-action {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .is-copied .examples-copy,
  .is-installed .examples-install {
    background: rgba(31, 138, 76, 0.85);
  }

  .examples-action-idle,
  .examples-action-ok {
    display: flex;
  }

  .examples-action-ok,
  .is-copied .examples-copy .examples-action-idle,
  .is-installed .examples-install .examples-action-idle {
    display: none;
  }

  .is-copied .examples-copy .examples-action-ok,
  .is-installed .examples-install .examples-action-ok {
    display: flex;
  }

  .examples-caption {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 2px;
  }

  .examples-site {
    font: 600 var(--text-base)/1.3 var(--font-ui);
    color: var(--fg);
  }

  .examples-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }

  .examples-hint {
    min-height: 20px;
    margin: 0;
    font: 400 var(--text-sm)/1.4 var(--font-ui);
    color: var(--fg-muted);
    visibility: hidden;
  }

  .is-copied .examples-hint {
    visibility: visible;
  }

  .examples-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 6px;
    margin: 0 -6px;
    border: none;
    border-radius: var(--radius-sm);
    background: none;
    cursor: pointer;
    white-space: nowrap;
    font: 400 var(--text-sm)/1.2 var(--font-ui);
    color: var(--fg-muted);
    transition: color 0.15s;
  }

  .examples-chip:hover,
  .examples-chip[aria-pressed='true'] {
    color: var(--fg);
  }

  .examples-chip[aria-pressed='true'] .examples-name {
    font-weight: 600;
  }

  .examples-dot,
  .lightbox-dot {
    width: 10px;
    height: 10px;
    flex: none;
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.18);
  }

  .lightbox-dot {
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3);
  }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 40px;
    border: none;
    background: transparent;
    cursor: zoom-out;
  }

  .lightbox::backdrop {
    background: rgba(12, 13, 16, 0.82);
    backdrop-filter: blur(6px);
  }

  .lightbox-body {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }

  .lightbox-img {
    width: min(1400px, 100%);
    max-height: calc(100vh - 140px);
    object-fit: contain;
    filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.5));
  }

  .lightbox-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    color: #fff;
  }

  .lightbox-site {
    font: 500 var(--text-sm)/1.3 var(--font-ui);
    opacity: 0.7;
  }

  .lightbox-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 14px;
  }

  .lightbox-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    margin: 0 -8px;
    border: none;
    border-radius: var(--radius-md);
    background: none;
    cursor: pointer;
    white-space: nowrap;
    font: 400 var(--text-sm)/1.2 var(--font-ui);
    color: rgba(255, 255, 255, 0.6);
  }

  .lightbox-chip:hover {
    color: #fff;
  }

  .lightbox-chip:focus-visible {
    color: #fff;
  }

  .lightbox-chip[aria-pressed='true'] {
    color: #fff;
    font-weight: 600;
  }

  .lightbox-note {
    margin-left: 6px;

---
import ChevronDownIcon from '@/components/icons/ChevronDownIcon';
import SyncIcon from '@/components/icons/SyncIcon';

import CarouselNav from './CarouselNav.astro';

const { t } = Astro.locals;
---

<section id="features" class="section features">
  <div class="section-inner">
    <div class="section-head">
      <h2 class="section-title" style="max-width:22ch">
        {t('Everything else you get.')}
      </h2>
      <CarouselNav
        target="features-track"
        previous={t('Previous feature')}
        next={t('Next feature')}
      />
    </div>
    <div id="features-track" class="carousel features-track">
      <article class="feature">
        <div class="feature-mock" aria-hidden="true">
          <div data-ed class="mock-card">
            <div class="sync-head">
              <span class="mock-title">{t('Connected to Google Drive')}</span>
              <span class="sync-pill">
                <span class="dot" />
                {t('Synced 2 minutes ago')}
              </span>
            </div>
            <div class="sync-grid">
              <span class="muted">{t('Saved to')}</span>
              <span class="sync-path">
                you@gmail.com <span class="faint">›</span>
                <span class="sync-file">
                  stylebot/stylebot_v3_backup.json ↗
                </span>
              </span>
              <span class="muted">{t('Schedule')}</span>
              <span>
                {t('Every 30 minutes, and right after you edit a style')}
              </span>
            </div>
            <div class="sync-foot">
              <span class="mock-btn">
                <SyncIcon />
                {t('Sync now')}
              </span>
              <span class="mock-link">{t('Disconnect')}</span>
            </div>
          </div>
        </div>
        <div class="feature-text">
          <h3>{t('Sync')}</h3>
          <p>
            {t(
              'Connect Google Drive and your styles follow you to every computer you sign in to. Stylebot syncs every 30 minutes and right after you edit.',
            )}
          </p>
        </div>
      </article>

      <article class="feature">
        <div class="feature-mock" aria-hidden="true">
          <div data-ed class="mock-card">
            <div class="hist-day">{t('Today, Sep 25')}</div>
            <div class="hist-row">
              <span class="hist-time">{t('1:04 AM')}</span>
              <span class="hist-what">
                <span style="color:var(--ink2)">{t('No changes')}</span>
              </span>
              <span class="faint hist-sites">{t('10 sites')}</span>
              <span class="hist-current">{t('Current')}</span>
            </div>
            <div class="hist-row">
              <span class="hist-time">{t('12:41 AM')}</span>
              <span class="hist-what">
                <span class="acc">{t('Edited')}</span>&nbsp; <b>github.com</b>
              </span>
              <span class="faint hist-sites">{t('10 sites')}</span>
              <span class="hist-chev">
                <ChevronDownIcon />
              </span>
            </div>
            <div class="hist-day">{t('Yesterday, Sep 24')}</div>
            <div class="hist-row last">
              <span class="hist-time">{t('11:41 PM')}</span>
              <span class="hist-what">
                <span class="acc">{t('Edited')}</span>&nbsp;{' '}
                <b>news.ycombinator.com</b>
              </span>
              <span class="faint hist-sites">{t('10 sites')}</span>
              <span class="hist-chev">
                <ChevronDownIcon />
              </span>
            </div>
          </div>
        </div>
        <div class="feature-text">
          <h3>{t('Version history')}</h3>
          <p>
            {t(
              'Every change to your styles is kept, newest first. Open an entry to see what changed and restore it in one click.',
            )}
          </p>
        </div>
      </article>

      <article class="feature">
        <div class="feature-mock" aria-hidden="true">
          <div data-ed class="preset-list">
            <div class="mock-card preset">
              <div class="preset-head">
                <span class="mock-title">{t('Readability')}</span>
                <span class="switch on">
                  <span />
                </span>
                <span class="preset-note">{t('Articles only')}</span>
              </div>
              <div class="preset-body">
                {t(
                  'A clean reading view, with your choice of theme, font, and size.',
                )}
              </div>
            </div>
            <div class="mock-card preset">
              <div class="preset-head">
                <span class="mock-title">{t('Grayscale')}</span>
                <span class="switch">
                  <span />
                </span>
              </div>
              <div class="preset-body">{t('Apply grayscale to the page.')}</div>
            </div>
          </div>
        </div>
        <div class="feature-text">
          <h3>{t('Presets')}</h3>
          <p>
            {t(
              'Readability and grayscale work on any site, and they stack with your own changes.',
            )}
          </p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .features {
    background: var(--surface);
  }

  .features-track {
    padding-bottom: 4px;
  }

  .feature {
    flex: 0 0 min(440px, 86%);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .feature-text {
    min-width: 0;
    padding: 0 4px;
  }

  .feature-text h3 {
    font: 600 20px/1.25 var(--display);
    letter-spacing: -0.015em;
    margin: 0 0 8px;
    color: var(--ink);
  }

  .feature-text p {
    font: 400 15px/1.6 var(--ui);
    color: var(--muted);
    margin: 0;
    max-width: 44ch;
    text-wrap: pretty;
  }

  .feature-mock {
    height: 400px;
    border-radius: 16px;
    background: var(--fill);
    border: 1px solid var(--border);
    display: grid;
    align-content: center;
    padding: 24px;
    overflow: hidden;
    color: var(--ink);
    font: 400 12.5px/1.4 var(--ui);
  }

  .feature-mock > [data-ed] {
    color: var(--ink);
  }

  .mock-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .mock-title {
    font: 600 14px/1.25 var(--ui);
    color: var(--ink);
  }

  .mock-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 13px;
    border-radius: 8px;
    border: 1px solid var(--strong);
    background: var(--surface);
    font: 600 12.5px/1 var(--ui);
    color: var(--ink);
  }

  .mock-link {
    font: 600 12.5px/1 var(--ui);
    color: var(--acc);
  }

  .muted {
    color: var(--muted);
  }

  .faint {
    color: var(--faint);
    flex: none;
  }

  .acc {
    color: var(--acc);
  }

  .sync-head {
    padding: 14px 16px;
    background: var(--fill);
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .sync-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 9px;
    border-radius: 12px;
    border: 1px solid #bfe3cc;
    background: #eef8f1;
    font: 600 11.5px/1 var(--ui);
    color: #1f7a45;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: #1f8a4c;
  }

  :global(:root:is([data-theme='dark'], [data-theme='stylebot'])) .sync-pill {
    border-color: #24563a;
    background: #173a24;
    color: #6fdd8b;
  }

  :global(:root:is([data-theme='dark'], [data-theme='stylebot'])) .dot {
    background: #4ac26b;
  }

  .sync-grid {
    padding: 14px 16px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 10px 18px;
  }

  .sync-path {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sync-foot {
    padding: 0 16px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .sync-file {
    margin-left: 0.3em;
    font: 400 11.5px/1.4 var(--mono);
    color: var(--acc);
  }

  .hist-day {
    padding: 10px 16px;
    background: var(--fill);
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    line-height: 1.2;
  }

  .hist-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    font: 400 13px/1.2 var(--ui);
  }

  .hist-row.last {
    border-bottom: none;
  }

  .hist-row b {
    font-weight: 600;
  }

  .hist-time {
    width: 66px;
    flex: none;
    color: var(--muted);
  }

  .hist-what {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .hist-current {
    padding: 4px 9px;
    border-radius: 10px;
    border: 1px solid var(--accline);
    background: var(--acctint);
    font: 600 11.5px/1 var(--ui);
    color: var(--acc);
    flex: none;
  }

  .hist-chev {
    width: 52px;
    flex: none;
    display: flex;
    justify-content: flex-end;
    color: var(--faint);
  }

  .preset-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .preset {
    padding: 14px 16px;
  }

  .preset-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .preset-note {
    margin-left: auto;
    font: 400 12px/1 var(--ui);
    color: var(--muted);
  }

  .preset-body {
    margin-top: 8px;
    color: var(--muted);
    line-height: 1.5;
  }

  .switch {
    width: 36px;
    height: 20px;
    border-radius: 10px;
    flex: none;
    position: relative;
    background: var(--strong);
  }

  .switch > span {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
  }

  .switch.on {
    background: var(--acc);
  }

  .switch.on > span {
    left: 18px;
  }

  @media (max-width: 639px) {
    .feature {
      flex-basis: min(440px, 90%);
    }

    .feature-mock {
      height: auto;
      min-height: 360px;
      padding: 12px;
    }
  }

  @media (max-width: 420px) {
    .hist-row {
      gap: 10px;
    }

    .hist-sites {
      display: none;
    }

    .hist-chev {
      width: auto;
    }
  }
</style>

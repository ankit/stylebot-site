---
import ButtonLink from '@/components/ButtonLink';
import Tooltip from '@/components/Tooltip';
import BookIcon from '@/components/icons/BookIcon';
import GitHubIcon from '@/components/icons/GitHubIcon';

import { ThemeMenu } from '@/theme';

import { LINKS } from '@/lib/links';

import Logo from './Logo';
import StoreLink from './StoreLink.astro';
import LanguageMenu from './LanguageMenu.astro';

type Props = {
  current?: 'manual';
  storeCta?: boolean;
  install?: boolean;
  // For another site on the header: the logo's label and a tag beside it.
  homeLabel?: string;
  tag?: string;
};

const { path, strings, t } = Astro.locals;
const {
  current,
  storeCta = false,
  install = true,
  homeLabel = t('Stylebot home'),
  tag,
} = Astro.props;
---

<header class="site-header">
  <div class="site-header-inner">
    <Logo client:idle href={path('/')} label={homeLabel} />
    {tag && (
      <a href={path('/')} class="logo-tag">
        <span class="logo-tag-rule" aria-hidden="true" />
        {tag}
      </a>
    )}
    <div class="header-actions">
      <LanguageMenu />
      <ThemeMenu client:idle strings={strings('theme/')} />
      <slot name="actions">
        <a
          href={path(LINKS.manual)}
          class:list={['icon-btn', { 'is-current': current === 'manual' }]}
          aria-label={t('Manual')}
          aria-current={current === 'manual' ? 'page' : undefined}
        >
          <BookIcon />
          <Tooltip>{t('Manual')}</Tooltip>
        </a>
        <a href={LINKS.github} class="icon-btn" aria-label="GitHub">
          <GitHubIcon />
          <Tooltip>GitHub</Tooltip>
        </a>
        {install &&
          (storeCta ? (
            <StoreLink
              index={0}
              format="add"
              variant="primary"
              size="sm"
              class="header-store"
            />
          ) : (
            <ButtonLink href={path('/#install')} size="sm">
              {t('Install')}
            </ButtonLink>
          ))}
      </slot>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header')!;
  const update = () =>
    header.classList.toggle('is-scrolled', window.scrollY > 8);

  window.addEventListener('scroll', update, { passive: true });
  update();
</script>

<style>
  .header-actions :global(.btn-sm) {
    margin-left: 10px;
  }

  .header-actions > :global(:last-child .tooltip) {
    left: auto;
    right: 0;
    transform: translate(0, -3px);
  }

  .header-actions > :global(:last-child .icon-btn:hover .tooltip),
  .header-actions > :global(:last-child .icon-btn:focus-visible .tooltip) {
    transform: translate(0, 0);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--layer-header);
    border-bottom: 1px solid transparent;
    background: transparent;
    transition:
      background 0.2s,
      border-color 0.2s;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--border);
    background: color-mix(in srgb, var(--bg-surface) 72%, transparent);
    backdrop-filter: saturate(180%) blur(16px);
  }

  .site-header-inner {
    max-width: var(--width-page);
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: 56px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .logo-tag {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: -2px;
    font:
      italic 500 21px/1 'Cormorant Garamond',
      Georgia,
      serif;
    color: var(--fg-secondary);
  }

  .logo-tag:hover {
    color: var(--fg);
  }

  .logo-tag-rule {
    width: 1px;
    height: 16px;
    background: var(--border-strong);
  }

  .header-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  @media (max-width: 639px) {
    .header-actions :global(.header-store) {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .site-header-inner:not(:has(:global(.header-store))) :global(.logo-name) {
      display: none;
    }

    .header-actions {
      gap: 2px;
    }

    .header-actions :global(.btn-sm) {
      margin-left: 6px;
      padding: 9px 12px;
    }
  }
</style>

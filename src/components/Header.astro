---
import BookIcon from '@/components/icons/BookIcon';
import GitHubIcon from '@/components/icons/GitHubIcon';

import Logo from './Logo';
import { ThemeMenu } from '@/theme';
import StoreLink from './StoreLink.astro';
import LanguageMenu from './LanguageMenu.astro';
import { LINKS } from '@/lib/links';

type Props = { current?: 'manual'; storeCta?: boolean; install?: boolean };
const { current, storeCta = false, install = true } = Astro.props;
const { path, site: t } = Astro.locals;
const themeLabels = {
  title: t.header.theme,
  names: t.themes,
};
---

<header class="site-header">
  <div class="site-header-inner">
    <Logo client:idle href={path('/')} label={t.header.home} />
    <div class="header-actions">
      <LanguageMenu />
      <ThemeMenu client:idle labels={themeLabels} />
      <a
        href={path(LINKS.manual)}
        class:list={['icon-btn', { 'is-current': current === 'manual' }]}
        aria-label={t.header.manual}
        aria-current={current === 'manual' ? 'page' : undefined}
      >
        <BookIcon />
        <span class="tip">{t.header.manual}</span>
      </a>
      <a href={LINKS.github} class="icon-btn" aria-label="GitHub">
        <GitHubIcon />
        <span class="tip">GitHub</span>
      </a>
      {install &&
        (storeCta ? (
          <StoreLink
            index={0}
            format="add"
            class="btn btn-primary btn-sm header-store"
          />
        ) : (
          <a href={path('/#install')} class="btn btn-primary btn-sm">
            {t.header.install}
          </a>
        ))}
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header')!;
  const update = () =>
    header.classList.toggle('is-scrolled', window.scrollY > 8);

  window.addEventListener('scroll', update, { passive: true });
  update();
</script>

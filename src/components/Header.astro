---
import Logo from './Logo';
import ThemeMenu from './ThemeMenu';
import LanguageMenu from './LanguageMenu.astro';
import { localizePath, messagesFor } from '../i18n';

type Props = {
  homeLabel: string;
  tag?: string;
};

const { homeLabel, tag } = Astro.props;

const { locale, site: t } = messagesFor(Astro.url);
const home = localizePath(locale, '/');
const themeLabels = {
  title: t.header.theme,
  names: t.themes,
};
---

<header class="site-header">
  <div class="site-header-inner">
    <Logo client:idle href={home} label={homeLabel} />
    {tag && (
      <a href={home} class="logo-tag">
        <span class="logo-tag-rule" aria-hidden="true"></span>
        {tag}
      </a>
    )}
    <div class="header-actions">
      <LanguageMenu />
      <ThemeMenu client:idle labels={themeLabels} />
      <slot />
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header')!;
  const update = () =>
    header.classList.toggle('is-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', update, { passive: true });
  update();
</script>

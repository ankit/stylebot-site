---
import BookIcon from '@/components/icons/BookIcon';
import GitHubIcon from '@/components/icons/GitHubIcon';

import { ThemeMenu } from '@/theme';

import { LINKS } from '@/lib/links';

import Logo from './Logo';
import StoreLink from './StoreLink.astro';
import LanguageMenu from './LanguageMenu.astro';

type Props = { current?: 'manual'; storeCta?: boolean; install?: boolean };
const { current, storeCta = false, install = true } = Astro.props;
const { path, strings, t } = Astro.locals;
---

<header class="site-header">
  <div class="site-header-inner">
    <Logo client:idle href={path('/')} label={t('Stylebot home')} />
    <div class="header-actions">
      <LanguageMenu />
      <ThemeMenu client:idle strings={strings('theme/')} />
      <a
        href={path(LINKS.manual)}
        class:list={['icon-btn', { 'is-current': current === 'manual' }]}
        aria-label={t('Manual')}
        aria-current={current === 'manual' ? 'page' : undefined}
      >
        <BookIcon />
        <span class="tooltip">{t('Manual')}</span>
      </a>
      <a href={LINKS.github} class="icon-btn" aria-label="GitHub">
        <GitHubIcon />
        <span class="tooltip">GitHub</span>
      </a>
      {install &&
        (storeCta ? (
          <StoreLink
            index={0}
            format="add"
            class="btn btn-primary btn-sm header-store"
          />
        ) : (
          <a href={path('/#install')} class="btn btn-primary btn-sm">
            {t('Install')}
          </a>
        ))}
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header')!;
  const update = () =>
    header.classList.toggle('is-scrolled', window.scrollY > 8);

  window.addEventListener('scroll', update, { passive: true });
  update();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--layer-header);
    border-bottom: 1px solid transparent;
    background: transparent;
    transition:
      background 0.2s,
      border-color 0.2s;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--border);
    background: color-mix(in srgb, var(--bg-surface) 72%, transparent);
    backdrop-filter: saturate(180%) blur(16px);
  }

  .site-header-inner {
    max-width: var(--width-page);
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: 56px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .header-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  @media (max-width: 639px) {
    .header-actions :global(.header-store) {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .site-header-inner:not(:has(:global(.header-store))) :global(.logo-name) {
      display: none;
    }

    .header-actions {
      gap: 2px;
    }

    .header-actions :global(.btn-sm) {
      margin-left: 6px;
      padding: 9px 12px;
    }
  }
</style>

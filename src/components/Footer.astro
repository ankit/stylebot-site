---
import CoffeeIcon from '@/components/icons/CoffeeIcon';

import { LINKS } from '@/lib/links';

const { path, t } = Astro.locals;

const links = [
  { label: t('Manual'), href: path(LINKS.manual) },
  { label: t('CLI'), href: path(LINKS.cli) },
  { label: t('Gallery'), href: LINKS.gallery + path('/') },
  { label: t('Changelog'), href: LINKS.changelog },
];
---

<footer class="site-footer">
  <div class="site-footer-links">
    {links.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
    <a href={LINKS.donate} class="coffee">
      <CoffeeIcon />
      {t('Buy me a coffee')}
    </a>
  </div>
  <span>
    © {new Date().getFullYear()} <a href={LINKS.author}>Ankit Ahuja</a>
  </span>
</footer>

<style>
  .site-footer {
    margin-top: 56px;
    padding: 20px 0 40px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 22px;
    font: 400 var(--text-sm)/1.4 var(--font-ui);
    color: var(--fg-muted);
  }

  .site-footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
  }

  .site-footer a {
    color: var(--fg-muted);
  }

  .site-footer a:hover {
    color: var(--link, var(--fg));
  }

  .coffee {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    line-height: 1;
  }

  .coffee svg {
    display: block;
    flex: none;
  }
</style>

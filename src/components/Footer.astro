---
import CoffeeIcon from '@/components/icons/CoffeeIcon';
import { LINKS } from '../lib/links';

const { site: t } = Astro.locals;
---

<footer class="site-footer">
  <div class="site-footer-links">
    <a href={LINKS.changelog} class="mono">
      v4
    </a>
    <a href={LINKS.changelog}>{t.footer.changelog}</a>
    <a href={LINKS.donate} class="coffee">
      <CoffeeIcon />
      {t.footer.donate}
    </a>
  </div>
  <span>
    © {new Date().getFullYear()} <a href={LINKS.author}>Ankit Ahuja</a>
  </span>
</footer>

<style>
  .coffee {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    line-height: 1;
  }

  .coffee svg {
    display: block;
    flex: none;
    margin-top: -3px;
  }
</style>

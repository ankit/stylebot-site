---
import CheckIcon from '@/components/icons/CheckIcon';
import CopyIcon from '@/components/icons/CopyIcon';

type Props = {
  lines: Array<string>;
  copy?: boolean;
  boxed?: boolean;
  class?: string;
};

const { lines, copy = true, boxed = false, class: className } = Astro.props;
const { t } = Astro.locals;
const command = lines.join(' && ');
---

<div
  class:list={['cli-cmd', { 'is-static': !copy, 'is-boxed': boxed }, className]}
>
  <span class="cli-cmd-lines">
    {lines.map((line) => (
      <span class="cli-cmd-line">
        <span class="cli-cmd-prompt">$ </span>
        {line}
      </span>
    ))}
  </span>
  {copy && (
    <button
      type="button"
      class="cli-cmd-copy"
      data-copy={command}
      data-copy-label={t('Copy')}
      data-copied-label={t('Copied')}
      title={t('Copy')}
      aria-label={
        // i18n: {command} is a terminal command, such as npm install -g @stylebot/cli.
        t('Copy {command}', { command })
      }
    >
      <span class="cli-cmd-idle">
        <CopyIcon size={14} />
      </span>
      <span class="cli-cmd-ok">
        <CheckIcon size={14} />
      </span>
    </button>
  )}
</div>

<script>
  import { track } from '@/lib/analytics';

  document
    .querySelectorAll<HTMLButtonElement>('.cli-cmd-copy')
    .forEach((button) => {
      let timer: ReturnType<typeof setTimeout>;

      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy!);
        } catch {
          return;
        }

        track('CLI copy', { command: button.dataset.copy! });
        button.classList.add('is-copied');
        button.title = button.dataset.copiedLabel!;
        clearTimeout(timer);
        timer = setTimeout(() => {
          button.classList.remove('is-copied');
          button.title = button.dataset.copyLabel!;
        }, 1600);
      });
    });
</script>

<style>
  .cli-cmd {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding: 5px 5px 5px 12px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--surface);
    font: 400 13px/1.4 var(--mono);
    color: var(--ink);
  }

  .cli-cmd.is-boxed {
    padding: 6px 6px 6px 14px;
    border-radius: 10px;
    font-size: var(--text-sm);
  }

  .cli-cmd.is-static {
    padding: 10px 12px;
  }

  .cli-cmd-lines {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cli-cmd-line {
    overflow-wrap: anywhere;
  }

  .cli-cmd-prompt {
    color: var(--faint);
    user-select: none;
  }

  .cli-cmd-copy {
    flex: none;
    width: 30px;
    height: 30px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    color: var(--muted);
  }

  .cli-cmd-copy:hover {
    border-color: var(--strong);
    background: var(--hover);
    color: var(--ink);
  }

  .cli-cmd-idle,
  .cli-cmd-ok {
    display: flex;
  }

  .cli-cmd-ok,
  .is-copied .cli-cmd-idle {
    display: none;
  }

  .is-copied .cli-cmd-ok {
    display: flex;
  }

  .cli-cmd-copy.is-copied {
    color: var(--acc);
  }
</style>

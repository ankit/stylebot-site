---
import ChevronLeftIcon from '@/components/icons/ChevronLeftIcon';
import ChevronRightIcon from '@/components/icons/ChevronRightIcon';

type Props = { target: string; previous: string; next: string };
const { target, previous, next } = Astro.props;
---

<div class="carousel-nav" data-carousel-nav={target}>
  <button class="round-btn" data-dir="-1" aria-label={previous}>
    <ChevronLeftIcon />
  </button>
  <button class="round-btn" data-dir="1" aria-label={next}>
    <ChevronRightIcon />
  </button>
</div>

<script>
  import './carousel';
</script>

<style>
  .carousel-nav {
    display: flex;
    gap: 8px;
    flex: none;
  }

  .round-btn {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-strong);
    background: var(--bg-surface);
    color: var(--fg);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .round-btn:hover {
    background: var(--bg-hover);
  }
</style>

---
import Header from '@/components/Header.astro';
import GalleryFooter from '@/gallery/components/GalleryFooter.astro';

import { homeTitle } from '@/gallery/lib/titles';

import Base from '@/layouts/Base.astro';

import './Gallery.css';

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
  alternates?: boolean;
};

const { t } = Astro.locals;
const {
  title = homeTitle(t),
  description = t(
    'Styles people made with Stylebot for the sites they use. Pick one and install it in a click.',
  ),
  noindex,
  alternates,
} = Astro.props;
---

<Base
  footer={false}
  description={description}
  fullTitle={t('{title} | Stylebot', { title })}
  noindex={noindex}
  alternates={alternates}
>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@1,6..72,400&display=swap"
    rel="stylesheet"
  />
  <Header
    slot="header"
    homeLabel={t('Stylebot gallery home')}
    tag={
      // i18n: A short tag next to the Stylebot logo, naming this part of the site.
      t('Gallery')
    }
  >
    <div slot="actions" id="account-nav" class="account-nav-slot" />
  </Header>
  <main class="g-main">
    <slot />
  </main>
  <div class="container">
    <GalleryFooter />
  </div>
</Base>

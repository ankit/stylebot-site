---
import { BROWSERS, LINKS, STORES } from '@/lib/links';

import { parts } from '@/i18n';

const { path, t } = Astro.locals;

const stores = Object.fromEntries(
  BROWSERS.map((browser, i) => [`{store${i + 1}}`, STORES[browser]]),
);
---

<footer class="gallery-footer">
  <p>
    {parts(
      // i18n: {stylebot} links to stylebot.dev; {store1}, {store2} and {store3} are Chrome, Firefox and Edge, each linking to its store.
      t(
        'Styles made with {stylebot}. Get it for {store1}, {store2} or {store3}.',
      ),
    ).map((part) => (
      <>
        {part === '{stylebot}' && <a href={LINKS.site + path('/')}>Stylebot</a>}
        {stores[part] && <a href={stores[part].href}>{stores[part].name}</a>}
        {part !== '{stylebot}' && !stores[part] && part}
      </>
    ))}
  </p>
</footer>

<style>
  .gallery-footer {
    margin-top: 56px;
    padding: 20px 0 40px;
    border-top: 1px solid var(--border);
    font: 400 var(--text-sm)/1.4 var(--font-ui);
    color: var(--fg-muted);
  }

  .gallery-footer p {
    margin: 0;
  }

  .gallery-footer a {
    color: var(--fg-muted);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
  }

  .gallery-footer a:hover {
    color: var(--link, var(--fg));
  }
</style>

---
import GalleryApp from '@/gallery/components/GalleryApp';
import Gallery from '@/gallery/layouts/Gallery.astro';

import { localeStaticPaths } from '@/i18n';

export const getStaticPaths = localeStaticPaths;

const { locale, strings } = Astro.locals;
---

<Gallery>
  <div class="g-page">
    <GalleryApp
      client:only="preact"
      locale={locale}
      strings={strings('gallery/components/', 'components/ZoomableImage.tsx')}
    />
  </div>
</Gallery>

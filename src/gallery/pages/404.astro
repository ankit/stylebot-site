---
import Gallery from '@/gallery/layouts/Gallery.astro';

const { path, t } = Astro.locals;
---

<Gallery title={t('Page not found')} noindex>
  <div class="g-page">
    <div class="g-empty">
      <h1 class="g-title">{t('Page not found')}</h1>
      <a class="btn btn-outline btn-sm" href={path('/')}>
        {t('All styles')}
      </a>
    </div>
  </div>
</Gallery>

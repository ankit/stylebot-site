---
import Base from '@/layouts/Base.astro';

import GalleryMock from '@/www/components/GalleryMock.astro';
import SyncMock from '@/www/components/SyncMock.astro';
import Callout from '@/www/components/manual/Callout.astro';
import Keys from '@/www/components/manual/Keys.astro';
import ProfilesMock from '@/www/components/manual/ProfilesMock.astro';
import Shot from '@/www/components/manual/Shot.astro';
import Term from '@/www/components/manual/Term.astro';
import Terms from '@/www/components/manual/Terms.astro';

import { LINKS } from '@/lib/links';

import { localeStaticPaths, rich } from '@/i18n';

import basicShot from '@/assets/manual/editor-detail.png';
import basicDarkShot from '@/assets/manual/editor-detail-dark.png';

export const getStaticPaths = localeStaticPaths;

const { path, t } = Astro.locals;

const toc = Object.entries({
  start: t('Getting started'),
  gallery: t('Gallery'),
  cli: t('Command line'),
  profiles: t('Profiles'),
  sync: t('Sync and history'),
  presets: t('Presets'),
  shortcuts: t('Keyboard shortcuts'),
  urls: t('Where styles apply'),
  help: t('Support'),
});

const steps = [
  t(
    'Click the Stylebot icon in the toolbar, then <strong>Style this page</strong>.',
  ),
  t(
    'Click the picker, hover the page and click an element. Press [[↑]] before clicking to select its parent instead.',
  ),
  t(
    'Change it in <strong>Basic</strong>, or write CSS in <strong>Code</strong>.',
  ),
];

const patterns = [
  ['docs.google.com', t('That domain and its subdomains.')],
  [
    'docs.google.com, drive.google.com',
    t('Either site. Separate patterns with a comma.'),
  ],
  ['*.ycombinator.com', t('Any subdomain. * matches anything up to a /.')],
  [
    'example.com/docs/**',
    t('Everything under a path. ** matches anything, including /.'),
  ],
  ['*', t('Every site.')],
  [
    '^https://www\\.reddit\\.com/$',
    t('A regular expression, here only the Reddit homepage. Start it with ^.'),
  ],
];

type Shortcut = [string, Array<string> | null, string?];

const globalShortcuts: Array<Shortcut> = [
  [t('Toggle editor'), ['alt', 'shift', 'M']],
  [t('Toggle styling'), ['alt', 'shift', 'S']],
  [t('Toggle readability'), null],
  [t('Toggle grayscale'), null],
];

const pickerShortcuts: Array<Shortcut> = [
  [t('Select the parent element'), ['↑', '←'], t('or')],
  [t('Go back to the child element'), ['↓', '→'], t('or')],
  [t('Select the highlighted element'), ['enter']],
];

const shortcutGroups = [
  { title: t('Global'), rows: globalShortcuts },
  { title: t('While picking an element'), rows: pickerShortcuts },
];
---

<Base
  title={t('Manual')}
  description={t(
    'How to use Stylebot: styling a site, profiles, the command line, sync, URL rules and shortcuts.',
  )}
>
  <div class="manual">
    <div class="manual-intro">
      <h1>{t('Manual')}</h1>
      <p>{t('How to restyle websites with Stylebot.')}</p>
    </div>

    <div class="manual-body">
      <nav class="toc" aria-label={t('Manual sections')}>
        {toc.map(([id, label], i) => (
          <a
            href={`#${id}`}
            data-toc={id}
            class:list={{ 'is-active': i === 0 }}
          >
            {label}
          </a>
        ))}
      </nav>

      <main class="sections">
        <section id="start">
          <h2>{t('Getting started')}</h2>
          <ol class="steps">
            {steps.map((step) => (
              <li set:html={rich(step)} />
            ))}
          </ol>
          <p>
            {t(
              'Changes save as you make them and load every time you visit the site.',
            )}
          </p>
          <Shot
            label={t('The Basic tab, picking a link in a Wikipedia article')}
            src={basicShot}
            dark={basicDarkShot}
          />
          <Terms>
            <Term term={t('Other ways to open it')}>
              <Fragment
                set:html={rich(
                  t(
                    'Press [[alt+shift+M]] on any tab, or right-click an element and choose <strong>Stylebot → Style Element</strong>.',
                  ),
                )}
              />
            </Term>
            <Term term={t('Turning a style off')}>
              <Fragment
                set:html={rich(
                  t(
                    'Use the switch in the popup, or [[alt+shift+S]]. The style is kept, just not applied.',
                  ),
                )}
              />
            </Term>
          </Terms>
          <Callout>
            {t(
              'If a style stops working after a site updates, pick the element again.',
            )}
          </Callout>
        </section>

        <section id="gallery">
          <h2>{t('Gallery')}</h2>
          <p
            set:html={t(
              'The <a href="{gallery}">Gallery</a> has styles other people made with Stylebot. Preview one on the site it’s for, read its CSS, and install it in a click.',
              { gallery: LINKS.gallery },
            )}
          />
          <div class="mock" aria-hidden="true">
            <GalleryMock />
          </div>
          <Terms>
            <Term term={t('Installed styles')}>
              {t(
                'The popup suggests popular styles for the site you’re on. An installed style updates on its own until you edit it.',
              )}
            </Term>
            <Term term={t('Publishing a style')}>
              <Fragment
                set:html={t(
                  'Choose <strong>Publish to Gallery</strong> from a style’s <strong>⋯</strong> menu in the popup, or from the editor’s <strong>⋯</strong> menu, and sign in with Google. Your edits stay on your computer until you publish an update.',
                )}
              />
            </Term>
            <Term term={t('Your styles')}>
              {t(
                'Sign in on the Gallery to rename or delete the styles you published, and to change your username.',
              )}
            </Term>
          </Terms>
        </section>

        <section id="cli">
          <h2>{t('Command line')}</h2>
          <p
            set:html={rich(
              t(
                'The <code>stylebot</code> command lets a coding agent like Claude Code, Codex or Cursor restyle sites right in your browser. It works in Chrome, Edge and other Chromium browsers. The <a href="{cli}">CLI page</a> walks through setup.',
              ),
              {
                cli: path(LINKS.cli),
              },
            )}
          />
        </section>

        <section id="profiles">
          <h2>{t('Profiles')}</h2>
          <p
            set:html={rich(
              t(
                'Profiles let you keep more than one look for a site and switch between them in the popup. To turn styling off for the site, choose <strong>No style</strong>.',
              ),
            )}
          />
          <div class="mock" aria-hidden="true">
            <ProfilesMock />
          </div>
          <Terms>
            <Term term={t('Style options')}>
              <Fragment
                set:html={t(
                  'Some styles offer choices in the popup, such as light or dark mode. Add them to your own styles with <code>@var</code>, as the <a href="{guide}">style options guide</a> explains.',
                  { guide: LINKS.styleOptions },
                )}
              />
            </Term>
          </Terms>
        </section>

        <section id="sync">
          <h2>{t('Sync and history')}</h2>
          <p>
            {t(
              'Keep your styles on all your computers with Google Drive, and go back to any earlier version.',
            )}
          </p>
          <div class="mock" aria-hidden="true">
            <SyncMock />
          </div>
          <Terms>
            <Term term={t('Google Drive sync')}>
              {t(
                'Connect Google Drive in Options. Your styles, including profiles, sync every 30 minutes and shortly after you edit. Stylebot only sees the files it creates in your Drive.',
              )}
            </Term>
            <Term term={t('Conflicts')}>
              {t(
                'If a style changed on two computers, your newer edit is kept and the other version is saved in a comment, so nothing is lost.',
              )}
            </Term>
            <Term term={t('Backup')}>
              {t('Export and import all your styles as JSON from Options.')}
            </Term>
            <Term term={t('Version history')}>
              {t(
                'Every change on this computer is kept in Options, including ones that arrive through sync. Restore any earlier version, for some sites or all of them.',
              )}
            </Term>
          </Terms>
        </section>

        <section id="presets">
          <h2>{t('Presets')}</h2>
          <ul class="bullets">
            <li
              set:html={t(
                "<strong>Readability</strong> turns a site's articles into a clean reading view, with a choice of theme, font, size and width; it leaves pages that aren't articles alone.",
              )}
            />
            <li
              set:html={t(
                '<strong>Grayscale</strong> removes color from the site, at any strength.',
              )}
            />
          </ul>
        </section>

        <section id="shortcuts">
          <h2>{t('Keyboard shortcuts')}</h2>
          <p
            set:html={rich(
              t(
                "Global shortcuts work on any page Stylebot can style; change them in your browser's shortcut settings, linked from Options. For the editor's own shortcuts, press [[?]] in the editor.",
              ),
            )}
          />
          {shortcutGroups.map((group) => (
            <div class="table">
              <div class="table-head">{group.title}</div>
              {group.rows.map(([action, keys, sep]) => (
                <div class="table-row shortcut">
                  <span class="shortcut-action">{action}</span>
                  {keys ? (
                    <Keys keys={keys} sep={sep} />
                  ) : (
                    <span class="shortcut-unset">
                      {t('Not set; assign in your browser')}
                    </span>
                  )}
                </div>
              ))}
            </div>
          ))}
        </section>

        <section id="urls">
          <h2>{t('Where styles apply')}</h2>
          <p>
            {t(
              'By default, a style applies to its domain and subdomains. To change that, edit its URL in Options using these patterns.',
            )}
          </p>
          <dl class="patterns">
            {patterns.map(([pattern, meaning]) => (
              <>
                <dt>
                  <code>{pattern}</code>
                </dt>
                <dd>{meaning}</dd>
              </>
            ))}
          </dl>
        </section>

        <section id="help">
          <h2>{t('Support')}</h2>
          <p
            set:html={rich(
              t(
                'Found a bug or have an idea? <a href="{feedback}">Send feedback</a> or open an issue on <a href="{issues}">GitHub</a>. Stylebot is free and open source, maintained since 2011. If it\'s useful to you, you can support it by <a href="{donate}">buying me a coffee</a>.',
              ),
              {
                feedback: path(LINKS.feedback),
                issues: LINKS.issues,
                donate: LINKS.donate,
              },
            )}
          />
        </section>
      </main>
    </div>
  </div>
</Base>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  const sections = links
    .map((link) => document.getElementById(link.dataset.toc!))
    .filter((el): el is HTMLElement => !!el);

  function setActive(id: string) {
    links.forEach((link) =>
      link.classList.toggle('is-active', link.dataset.toc === id),
    );
  }

  function onScroll() {
    let current = sections[0]?.id;

    for (const section of sections) {
      if (section.getBoundingClientRect().top < 140) {
        current = section.id;
      }
    }

    if (current) {
      setActive(current);
    }
  }

  links.forEach((link) =>
    link.addEventListener('click', () => setActive(link.dataset.toc!)),
  );
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .manual {
    max-width: var(--width-page);
    margin: 0 auto;
    padding: 64px var(--gutter) 0;
  }

  .manual-intro {
    max-width: var(--width-text);
    margin-bottom: 36px;
  }

  .manual-intro h1 {
    margin: 0 0 12px;
    font: 600 clamp(30px, 3.6vw, 40px) / 1.1 var(--font-display);
    letter-spacing: -0.025em;
    color: var(--fg);
  }

  .manual-intro p {
    margin: 0;
    font: 400 var(--text-lg)/1.55 var(--font-ui);
    color: var(--fg-muted);
  }

  .manual-body {
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: flex-start;
  }

  .toc {
    flex: 0 0 220px;
    margin-left: -12px;
    position: sticky;
    top: 84px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toc a {
    display: block;
    padding: 7px 12px;
    border-radius: var(--radius-md);
    font: 400 var(--text-sm)/1.3 var(--font-ui);
    color: var(--fg-muted);
  }

  .toc a:hover {
    background: var(--bg-track);
    color: var(--fg);
  }

  .toc a.is-active {
    font-weight: 600;
    color: var(--fg);
    background: var(--bg-track);
  }

  .sections {
    flex: 1 1 480px;
    min-width: 0;
    max-width: var(--width-text);
  }

  section {
    scroll-margin-top: 88px;
    padding: 44px 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  h2 {
    margin: 0;
    font: 600 26px/1.2 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  p {
    margin: 0;
    font: 400 var(--text-base)/1.65 var(--font-ui);
    color: var(--fg-secondary);
    text-wrap: pretty;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .steps li {
    position: relative;
    padding-left: 36px;
    counter-increment: step;
    font: 400 var(--text-base)/1.65 var(--font-ui);
    color: var(--fg-secondary);
    text-wrap: pretty;
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    top: 1px;
    left: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--bg-badge);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 600 var(--text-xs)/1 var(--font-ui);
    color: var(--fg-secondary);
  }

  .bullets {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .bullets li {
    font: 400 var(--text-base)/1.65 var(--font-ui);
    color: var(--fg-secondary);
    text-wrap: pretty;
  }

  .sections :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }

  .sections :global(code) {
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    background: var(--bg-muted);
    border: 1px solid var(--border);
    font: 400 0.88em/1.5 var(--font-mono);
    color: var(--fg);
  }

  .sections :global(.keys) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }

  .sections :global(kbd) {
    display: inline-block;
    padding: 2px 7px;
    border-radius: var(--radius-sm);
    background: var(--bg-muted);
    border: 1px solid var(--border-strong);
    border-bottom-width: 2px;
    font: 500 var(--text-xs)/1.4 var(--font-mono);
    color: var(--fg-secondary);
  }

  .sections :global(.keys-sep) {
    font: 400 var(--text-xs)/1 var(--font-ui);
    color: var(--fg-subtle);
  }

  .sections :global(.callout) {
    display: flex;
    gap: 12px;
    padding: 14px 16px;
    border-radius: var(--radius-md);
    background: var(--bg-muted);
    border: 1px solid var(--border);
    font: 400 var(--text-base)/1.55 var(--font-ui);
    color: var(--fg-secondary);
    text-wrap: pretty;
  }

  .sections :global(.callout-icon) {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 3px;
    border-radius: var(--radius-full);
    background: var(--fg-muted);
    color: var(--bg-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 700 var(--text-xs)/1 system-ui;
  }

  .sections :global(.shot-image) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
  }

  .mock {
    color: var(--fg);
  }

  .sections :global(.mock-card) {
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--bg-surface);
    box-shadow: var(--shadow-lg);
  }

  .sections :global(.terms) {
    margin: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }

  .sections :global(.term) {
    display: grid;
    grid-template-columns: minmax(0, 180px) minmax(0, 1fr);
    gap: 8px 24px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }

  .sections :global(.terms:last-child > .term:last-child) {
    border-bottom: none;
  }

  .sections :global(.term dt) {
    font: 600 14.5px/1.5 var(--font-ui);
    color: var(--fg);
  }

  .sections :global(.term dd) {
    margin: 0;
    font: 400 15px/1.6 var(--font-ui);
    color: var(--fg-secondary);
    text-wrap: pretty;
  }

  .table {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-surface);
  }

  .table-head {
    padding: 10px 16px;
    background: var(--bg-muted);
    border-bottom: 1px solid var(--border);
    font: 600 var(--text-xs)/1 var(--font-ui);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .table-row {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 12px 16px;
    font: 400 var(--text-base)/1.55 var(--font-ui);
    color: var(--fg-secondary);
  }

  .table-row + .table-row {
    border-top: 1px solid var(--border);
  }

  .patterns {
    margin: 0;
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    border-top: 1px solid var(--border);
  }

  .patterns dt,
  .patterns dd {
    margin: 0;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }

  .patterns dt {
    padding-right: 24px;
  }

  .patterns dt code {
    white-space: nowrap;
  }

  .patterns dd {
    font: 400 var(--text-base)/1.55 var(--font-ui);
    color: var(--fg-secondary);
    text-wrap: pretty;
  }

  .patterns > :nth-last-child(-n + 2) {
    border-bottom: none;
  }

  .shortcut {
    align-items: center;
    padding: 11px 16px;
  }

  .shortcut-action {
    flex: 1;
    font: 400 var(--text-base)/1.4 var(--font-ui);
    color: var(--fg);
  }

  .shortcut-unset {
    font: 400 var(--text-sm)/1 var(--font-ui);
    color: var(--fg-subtle);
  }

  @media (max-width: 760px) {
    .manual {
      padding-top: 40px;
    }

    .manual-body {
      gap: 24px;
    }

    .toc {
      margin-left: 0;
      position: static;
      flex: 1 1 100%;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 6px;
    }

    .toc a {
      border: 1px solid var(--border);
      background: var(--bg-surface);
    }

    .patterns {
      grid-template-columns: minmax(0, 1fr);
    }

    .patterns dt {
      padding: 14px 0 4px;
      border-bottom: none;
    }

    .patterns dt code {
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .patterns dd {
      padding-top: 0;
    }

    .patterns dd:last-child {
      padding-bottom: 0;
    }

    .sections :global(.term) {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
</style>

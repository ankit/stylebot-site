---
import Base from '@/layouts/Base.astro';

import MonitorIcon from '@/components/icons/MonitorIcon';
import Demo from '@/www/components/demo/Demo';
import FeaturedStyles from '@/www/components/FeaturedStyles.astro';
import Features from '@/www/components/Features.astro';
import CliCommand from '@/www/components/cli/CliCommand.astro';
import CliSection from '@/www/components/cli/CliSection.astro';
import Quotes from '@/www/components/Quotes.astro';
import Footer from '@/components/Footer.astro';
import FeatureTour from '@/www/components/FeatureTour.astro';
import StoreLink from '@/components/StoreLink.astro';

import { CLI_INSTALL } from '@/www/lib/cli';
import { LINKS, STORES } from '@/lib/links';

import { localeStaticPaths, parts } from '@/i18n';

export const getStaticPaths = localeStaticPaths;

const { path, lang, locale, strings, t } = Astro.locals;

type RestyleFont = {
  family: string;
  generic: 'serif' | 'monospace' | 'sans-serif';
  italic?: boolean;
  weight?: number;
  size?: string;
  spacing?: string;
  shift?: string;
};

type RestyleScript =
  | 'latin'
  | 'latin-ext'
  | 'vietnamese'
  | 'cyrillic'
  | 'ja'
  | 'ko'
  | 'zh-cn'
  | 'zh-tw';

const LATIN_FONTS: Array<RestyleFont> = [
  {
    family: 'DM Serif Display',
    generic: 'serif',
    italic: true,
    spacing: '-0.02em',
    shift: '0.027em',
  },
  {
    family: 'JetBrains Mono',
    generic: 'monospace',
    weight: 500,
    size: '0.94em',
    spacing: '-0.06em',
    shift: '0.034em',
  },
  {
    family: 'Silkscreen',
    generic: 'monospace',
    size: '0.72em',
    spacing: '0',
    shift: '0.15em',
  },
  {
    family: 'Libre Caslon Text',
    generic: 'serif',
    weight: 700,
    size: '0.95em',
    spacing: '-0.02em',
    shift: '0.039em',
  },
];

/*
 * The headline word's four styles, per script: each font is a Google Font
 * that covers the whole word, so no letter falls back to another font.
 */
const RESTYLE_FONTS: Record<RestyleScript, Array<RestyleFont>> = {
  latin: LATIN_FONTS,
  'latin-ext': [
    LATIN_FONTS[0],
    LATIN_FONTS[1],
    {
      family: 'Pixelify Sans',
      generic: 'monospace',
      weight: 500,
      size: '0.9em',
      spacing: '0',
      shift: '0.08em',
    },
    LATIN_FONTS[3],
  ],
  vietnamese: [
    {
      family: 'Playfair Display',
      generic: 'serif',
      italic: true,
      spacing: '-0.02em',
      shift: '-0.06em',
    },
    {
      family: 'JetBrains Mono',
      generic: 'monospace',
      weight: 500,
      size: '0.88em',
      spacing: '-0.06em',
      shift: '0em',
    },
    {
      family: 'VT323',
      generic: 'monospace',
      size: '1.1em',
      spacing: '0',
      shift: '-0.06em',
    },
    {
      family: 'Old Standard TT',
      generic: 'serif',
      weight: 700,
      size: '0.95em',
      spacing: '-0.02em',
      shift: '0.094em',
    },
  ],
  cyrillic: [
    {
      family: 'Playfair Display',
      generic: 'serif',
      italic: true,
      spacing: '-0.02em',
      shift: '0.02em',
    },
    {
      family: 'JetBrains Mono',
      generic: 'monospace',
      weight: 500,
      size: '0.94em',
      spacing: '-0.06em',
      shift: '0.034em',
    },
    {
      family: 'Pixelify Sans',
      generic: 'monospace',
      weight: 500,
      size: '0.9em',
      spacing: '0',
      shift: '0.08em',
    },
    {
      family: 'Old Standard TT',
      generic: 'serif',
      weight: 700,
      size: '0.95em',
      spacing: '-0.02em',
      shift: '0.03em',
    },
  ],
  ja: [
    { family: 'Yuji Syuku', generic: 'serif', size: '0.96em', spacing: '0' },
    {
      family: 'M PLUS 1 Code',
      generic: 'monospace',
      weight: 500,
      size: '0.94em',
      spacing: '0',
    },
    {
      family: 'DotGothic16',
      generic: 'sans-serif',
      size: '0.94em',
      spacing: '0',
    },
    {
      family: 'Shippori Mincho',
      generic: 'serif',
      weight: 700,
      size: '0.95em',
      spacing: '0',
    },
  ],
  ko: [
    { family: 'Song Myung', generic: 'serif', size: '0.94em', spacing: '0' },
    {
      family: 'Nanum Gothic Coding',
      generic: 'monospace',
      size: '0.84em',
      spacing: '0',
    },
    {
      family: 'Do Hyeon',
      generic: 'sans-serif',
      size: '0.94em',
      spacing: '0',
    },
    {
      family: 'Nanum Myeongjo',
      generic: 'serif',
      weight: 800,
      size: '0.87em',
      spacing: '0',
    },
  ],
  'zh-cn': [
    {
      family: 'Ma Shan Zheng',
      generic: 'serif',
      spacing: '0',
    },
    {
      family: 'Noto Sans SC',
      generic: 'sans-serif',
      weight: 500,
      size: '0.94em',
      spacing: '0',
    },
    {
      family: 'ZCOOL QingKe HuangYou',
      generic: 'sans-serif',
      size: '0.94em',
      spacing: '0',
    },
    {
      family: 'Noto Serif SC',
      generic: 'serif',
      weight: 700,
      size: '0.95em',
      spacing: '0',
    },
  ],
  'zh-tw': [
    {
      family: 'LXGW WenKai TC',
      generic: 'serif',
      spacing: '0',
    },
    {
      family: 'Noto Sans TC',
      generic: 'sans-serif',
      weight: 500,
      size: '0.94em',
      spacing: '0',
    },
    {
      family: 'LXGW Marker Gothic',
      generic: 'sans-serif',
      size: '0.94em',
      spacing: '0',
    },
    {
      family: 'Noto Serif TC',
      generic: 'serif',
      weight: 700,
      size: '0.95em',
      spacing: '0',
    },
  ],
};

/**
 * Which set of fonts covers a word: by its letters, and for Chinese
 * characters, which are shared with Japanese, by the page's locale.
 */
function restyleScript(word: string): RestyleScript {
  if (/\p{Script=Hangul}/u.test(word)) {
    return 'ko';
  }

  if (/[\p{Script=Hiragana}\p{Script=Katakana}]/u.test(word)) {
    return 'ja';
  }

  if (/\p{Script=Han}/u.test(word)) {
    return locale === 'ja' || locale === 'ko' || locale === 'zh-tw'
      ? locale
      : 'zh-cn';
  }

  if (/\p{Script=Cyrillic}/u.test(word)) {
    return 'cyrillic';
  }

  if (
    // Vietnamese can spell tones as combining marks, which this matches too.
    // eslint-disable-next-line no-misleading-character-class
    /[\u01a0\u01a1\u01af\u01b0\u0300-\u036f\u1ea0-\u1ef9]/u.test(
      word.normalize('NFC'),
    )
  ) {
    return 'vietnamese';
  }

  return /[\u0100-\u024f]/u.test(word.normalize('NFC')) ? 'latin-ext' : 'latin';
}

const restyleFonts =
  RESTYLE_FONTS[
    restyleScript(
      // i18n: A single word, ideally short: the page cycles it through decorative fonts.
      t('Restyle'),
    )
  ];

const restyleFamilies = restyleFonts.map(({ family, italic, weight }) => {
  const axes = italic ? 'ital@1' : weight ? `wght@${weight}` : '';

  return `family=${family.replace(/ /g, '+')}${axes && `:${axes}`}`;
});

const restyleHref = `https://fonts.googleapis.com/css2?${restyleFamilies.join('&')}&display=swap&text=${encodeURIComponent(
  // i18n: A single word, ideally short: the page cycles it through decorative fonts.
  t('Restyle'),
)}`;

const restyleLoads = restyleFonts.map(
  ({ family, italic, weight }) =>
    `${italic ? 'italic ' : ''}${weight ?? 400} 1em '${family}'`,
);

const restyleVars = restyleFonts
  .map((font, i) =>
    [
      `--family-${i + 1}: '${font.family}', ${font.generic}`,
      `--style-${i + 1}: ${font.italic ? 'italic' : 'normal'}`,
      `--weight-${i + 1}: ${font.weight ?? 400}`,
      `--size-${i + 1}: ${font.size ?? '1em'}`,
      `--spacing-${i + 1}: ${font.spacing ?? 'normal'}`,
      `--shift-${i + 1}: ${font.shift ?? '0em'}`,
    ].join('; '),
  )
  .join('; ');

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Stylebot',
  url: new URL(path('/'), Astro.site).href,
  description: t(
    'Point at something on a page and change it. Stylebot writes the CSS and loads it every time you come back. Free and open source for Chrome, Firefox and Edge.',
  ),
  inLanguage: lang,
  applicationCategory: 'BrowserApplication',
  operatingSystem: 'Chrome, Firefox, Edge',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  downloadUrl: Object.values(STORES).map((store) => store.href),
  sameAs: [LINKS.github, ...Object.values(STORES).map((store) => store.href)],
  author: { '@type': 'Person', name: 'Ankit Ahuja', url: LINKS.author },
};
---

<Base footer={false} storeCta>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  />
  <link slot="head" href={restyleHref} rel="stylesheet" />
  <main>
    <div class="hero">
      <h1>
        {parts(
          // i18n: {word} is the title word ("Restyle"), a button that switches its own font each time it's clicked. Keep {word} at the start where the language allows: wider fonts grow it to the left.
          t('{word} any website.'),
        ).map((part) =>
          part === '{word}' ? (
            <button
              class="restyle"
              type="button"
              title={
                // i18n: Tooltip on the title word ("Restyle").
                t('Click to restyle')
              }
              data-fonts={JSON.stringify(restyleLoads)}
            >
              {
                // i18n: A single word, ideally short: the page cycles it through decorative fonts.
                t('Restyle')
              }
              <span
                class="restyle-cycle"
                aria-hidden="true"
                style={restyleVars}
              >
                {
                  // i18n: A single word, ideally short: the page cycles it through decorative fonts.
                  t('Restyle')
                }
              </span>
            </button>
          ) : (
            part
          ),
        )}
      </h1>
      <p>
        {t(
          'Point at something on the page and change it. Stylebot writes the CSS and loads your style every time you come back.',
        )}
      </p>
      <div class="cta">
        <div class="cta-row">
          <StoreLink index={0} format="add" variant="primary" />
          <span class="cta-also">
            {parts(t('Also on {first} and {second}')).map((part) =>
              part === '{first}' ? (
                <StoreLink index={1} format="name" class="ink-link" />
              ) : part === '{second}' ? (
                <StoreLink index={2} format="name" class="ink-link" />
              ) : (
                part
              ),
            )}
          </span>
        </div>
        <div class="cta-desktop">
          <MonitorIcon />
          <span
            set:html={
              // i18n: Shown on phones in place of the store buttons.
              t(
                'Stylebot runs on <strong>Chrome, Firefox and Edge</strong> on desktop.',
              )
            }
          />
        </div>
      </div>
    </div>

    <div class="demo-wrap">
      <div class="demo-full">
        <Demo client:visible strings={strings('www/components/demo/')} />
      </div>
      <div class="demo-tour">
        <FeatureTour />
      </div>
    </div>

    <CliSection />
    <FeaturedStyles />
    <Features />
    <Quotes />

    <section id="install" class="section">
      <div class="install">
        <h2>{t('Install Stylebot', { context: 'heading' })}</h2>
        <p>
          {t(
            'Free and open source since 2011. No account and no tracking. Your styles live in your browser, and the code is on GitHub.',
          )}
        </p>
        <div class="install-buttons">
          <StoreLink index={0} format="add" variant="primary" />
          <StoreLink index={1} format="name" variant="outline" />
          <StoreLink index={2} format="name" variant="outline" />
        </div>
        <div class="install-cli">
          <span
            set:html={t(
              'Using a coding agent? Add the <a href="#cli">CLI</a>:',
            )}
          />
          <CliCommand lines={[CLI_INSTALL]} boxed />
        </div>
        <Footer />
      </div>
    </section>
  </main>
</Base>

<script>
  import { reducedMotion } from '@/lib/motion';

  const STEPS = 5;
  const PLAY = [0, 350, 700, 1050, 1450];

  const button = document.querySelector<HTMLButtonElement>('.restyle')!;
  const word = button.querySelector<HTMLElement>('.restyle-cycle')!;

  for (const font of JSON.parse(button.dataset.fonts!) as Array<string>) {
    document.fonts.load(font, word.textContent!.trim());
  }

  let step = 0;
  let timers: Array<number> = [];

  function show(next: number) {
    step = next;
    word.dataset.step = String(step);
  }

  function stopPlaying() {
    timers.forEach(clearTimeout);
    timers = [];
    delete word.dataset.playing;
  }

  button.addEventListener('click', () => {
    stopPlaying();
    show((step + 1) % STEPS);
  });

  if (!reducedMotion()) {
    timers = PLAY.map((at, i) =>
      window.setTimeout(() => {
        const last = i === PLAY.length - 1;

        word.toggleAttribute('data-playing', !last);
        show(last ? 0 : i + 1);
      }, 400 + at),
    );
  }
</script>

<style>
  .hero {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(48px, 10vw, 88px) var(--gutter) clamp(32px, 6vw, 44px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .hero h1 {
    font: 700 clamp(36px, 5.4vw, 58px) / 1.04 var(--font-display);
    letter-spacing: -0.035em;
    margin: 0;
    text-wrap: balance;
  }

  .restyle {
    position: relative;
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    color: transparent;
    cursor: pointer;
  }

  .restyle:focus-visible {
    outline: none;
  }

  .restyle-cycle {
    position: absolute;
    right: -4px;
    top: 50%;
    translate: 0 -50%;
    padding: 0 4px;
    border-radius: 4px;
    color: var(--fg);
    white-space: nowrap;
    user-select: none;
    pointer-events: none;
    outline: 1.5px dashed transparent;
    outline-offset: 4px;
  }

  .restyle:hover .restyle-cycle,
  .restyle:focus-visible .restyle-cycle,
  .restyle-cycle[data-playing] {
    outline-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .restyle-cycle[data-step='1'] {
    translate: 0 calc(-50% + var(--shift-1));
    font-family: var(--family-1);
    font-size: var(--size-1);
    font-style: var(--style-1);
    font-weight: var(--weight-1);
    letter-spacing: var(--spacing-1);
    color: var(--accent);
  }

  .restyle-cycle[data-step='2'] {
    translate: 0 calc(-50% + var(--shift-2));
    font-family: var(--family-2);
    font-size: var(--size-2);
    font-style: var(--style-2);
    font-weight: var(--weight-2);
    letter-spacing: var(--spacing-2);
    color: #191b1f;
    background: #fde68a;
  }

  .restyle-cycle[data-step='3'] {
    translate: 0 calc(-50% + var(--shift-3));
    font-family: var(--family-3);
    font-size: var(--size-3);
    font-style: var(--style-3);
    font-weight: var(--weight-3);
    letter-spacing: var(--spacing-3);
    color: var(--accent);
    background: var(--accent-border);
  }

  .restyle-cycle[data-step='4'] {
    translate: 0 calc(-50% + var(--shift-4));
    font-family: var(--family-4);
    font-size: var(--size-4);
    font-style: var(--style-4);
    font-weight: var(--weight-4);
    letter-spacing: var(--spacing-4);
    color: #191b1f;
    background: #e7e4dc;
  }

  .hero p {
    font: 400 var(--text-lg)/1.55 var(--font-ui);
    color: var(--fg-muted);
    margin: 0;
    max-width: 48ch;
    text-wrap: pretty;
  }

  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .cta-also {
    white-space: nowrap;
    font: 400 var(--text-sm)/1.4 var(--font-ui);
    color: var(--fg-muted);
  }

  .cta-also :global(.ink-link) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
  }

  .cta-also :global(.ink-link:hover) {
    color: var(--link, var(--fg));
    text-decoration-color: var(--fg);
  }

  .demo-wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 var(--gutter) clamp(56px, 10vw, 88px);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .install {
    max-width: var(--width-page);
    margin: 0 auto;
    padding: clamp(56px, 10vw, 80px) var(--gutter) 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .install h2 {
    font: 700 var(--text-2xl) / 1.1 var(--font-display);
    letter-spacing: -0.03em;
    margin: 0;
  }

  .install p {
    font: 400 var(--text-base)/1.55 var(--font-ui);
    color: var(--fg-muted);
    margin: 0;
    max-width: var(--width-subtitle);
  }

  .install-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }

  .install-cli {
    margin-top: 10px;
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font: 400 var(--text-sm)/1.4 var(--font-ui);
    color: var(--fg-muted);
  }

  .install-cli :global(a) {
    color: var(--link, var(--fg));
  }

  .install :global(.site-footer) {
    width: 100%;
  }

  .demo-tour,
  .cta-desktop {
    display: none;
  }

  @media (max-width: 639px) {
    .cta-row,
    .demo-full {
      display: none;
    }

    .demo-tour {
      display: block;
    }

    .cta-desktop {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
      background: var(--bg-surface);
      font: 400 var(--text-sm)/1.45 var(--font-ui);
      color: var(--fg-muted);
      text-align: left;
      text-wrap: pretty;
    }

    .cta-desktop svg {
      flex: none;
      color: var(--fg-secondary);
    }

    .cta-desktop :global(strong) {
      font-weight: 600;
      color: var(--fg);
    }
  }
</style>

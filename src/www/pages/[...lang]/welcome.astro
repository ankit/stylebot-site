---
import Base from '@/layouts/Base.astro';

import Demo from '@/www/components/demo/Demo';

import { LINKS } from '@/lib/links';

import { localeStaticPaths } from '@/i18n';

export const getStaticPaths = localeStaticPaths;

const { path, strings, t } = Astro.locals;
---

<Base
  title={t('Welcome')}
  description={t('How Stylebot works, start to finish, in about a minute.')}
  install={false}
  noindex
>
  <main>
    <div class="demo-wrap">
      <Demo
        client:load
        variant="welcome"
        strings={strings('www/components/demo/')}
      >
        <div slot="intro" class="hero">
          <h1>{t('Stylebot is installed.')}</h1>
        </div>
        <div class="your-turn">
          <div class="your-turn-text">
            <strong>{t('Your turn.')}</strong>
            <span>
              {t(
                'Open any site and press the shortcut. Nothing changes until you do.',
              )}
            </span>
          </div>
          <span class="your-turn-keys">
            <kbd data-mac="⌥ Option">Alt</kbd>
            <kbd data-mac="⇧ Shift">Shift</kbd>
            <kbd>M</kbd>
          </span>
          <a href={path(LINKS.manual)} class="your-turn-link">
            {t('Manual')}
            <span>›</span>
          </a>
        </div>
      </Demo>
    </div>
    <div class="agent">
      <p class="agent-inner">
        <strong>{t('Works with your coding agent')}</strong>
        <span>
          {t(
            'Stylebot has a CLI, so any agent that can run commands can restyle a site.',
          )}
        </span>
        <a href={path(LINKS.cli)}>{t('Set up the CLI →')}</a>
      </p>
    </div>
  </main>
</Base>

<script>
  import '@/www/components/manual/mac-keys';
</script>

<style>
  .hero {
    max-width: 760px;
    margin: 0 auto;
    padding: 56px 0 8px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .hero h1 {
    font: 700 clamp(36px, 5.4vw, 58px) / 1.04 var(--font-display);
    letter-spacing: -0.035em;
    margin: 0;
    text-wrap: balance;
  }

  .demo-wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 var(--gutter) 40px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .your-turn {
    margin-top: 20px;
    padding: 18px 22px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
  }

  .your-turn-text {
    flex: 1 1 280px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font: 400 var(--text-sm)/1.5 var(--font-ui);
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  .your-turn-text strong {
    font: 600 var(--text-base)/1.25 var(--font-ui);
    color: var(--fg);
  }

  .your-turn-keys {
    display: flex;
    gap: 5px;
  }

  .your-turn-keys kbd {
    min-width: 28px;
    height: 28px;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 8px;
    border-radius: 6px;
    background: var(--bg-surface);
    border: 1px solid var(--border-strong);
    border-bottom-width: 3px;
    font: 600 12px/1 var(--font-ui);
    color: var(--fg);
    white-space: nowrap;
  }

  .your-turn-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 14px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-strong);
    font: 600 var(--text-sm)/1 var(--font-ui);
    color: var(--fg);
  }

  .your-turn-link:hover {
    background: var(--bg-hover);
    color: var(--fg);
  }

  .your-turn-link span {
    color: var(--fg-subtle);
  }

  .agent {
    max-width: var(--width-page);
    margin: 0 auto;
    padding: 16px var(--gutter) 48px;
  }

  .agent-inner {
    margin: 0;
    padding: 24px 22px 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    font: 400 var(--text-sm)/1.5 var(--font-ui);
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  .agent-inner strong {
    font-weight: 600;
    color: var(--fg);
  }

  .agent-inner a {
    font-weight: 600;
    color: var(--fg-muted);
    white-space: nowrap;
  }

  .agent-inner a:hover {
    color: var(--fg);
  }

  @media (min-width: 1100px) {
    .hero {
      padding: 24px 0 0;
      text-align: left;
      align-items: flex-start;
      gap: 22px;
    }

    .hero h1 {
      font-size: clamp(32px, 4vw, 44px);
      line-height: 1.06;
      letter-spacing: -0.03em;
    }

    .your-turn {
      margin-top: 0;
    }

    .demo-wrap,
    .agent {
      max-width: 1400px;
    }

    .demo-wrap {
      padding-top: 32px;
    }

    .agent-inner a {
      margin-left: auto;
    }
  }
</style>

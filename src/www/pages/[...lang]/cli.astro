---
import ButtonLink from '@/components/ButtonLink';
import Base from '@/layouts/Base.astro';

import ZoomableImage from '@/components/ZoomableImage';
import CliCommand from '@/www/components/cli/CliCommand.astro';
import CliTabs from '@/www/components/cli/CliTabs.astro';

import { CLI_INSTALL } from '@/www/lib/cli';
import { LINKS, STORES, storeHref } from '@/lib/links';
import { screenshot } from '@/www/lib/screenshots';

import { localeStaticPaths, rich } from '@/i18n';

import connect from '@/assets/cli/connect.webp';
import mark from '@/assets/cli/mark.webp';
import reply from '@/assets/cli/reply.webp';

export const getStaticPaths = localeStaticPaths;

const { strings, t } = Astro.locals;

const AGENTS = [
  {
    id: 'agent-claude',
    name: 'Claude Code',
    commands: [
      'claude plugin marketplace add ankit/stylebot',
      'claude plugin install stylebot',
    ],
  },
  {
    id: 'agent-codex',
    name: 'Codex',
    commands: [
      'codex plugin marketplace add ankit/stylebot',
      'codex plugin add stylebot@stylebot',
    ],
  },
  {
    id: 'agent-copilot',
    name: 'Copilot CLI',
    commands: [
      'copilot plugin marketplace add ankit/stylebot',
      'copilot plugin install stylebot@stylebot',
    ],
  },
];

const zoomStrings = strings('components/ZoomableImage.tsx');
const shots = {
  connect: await screenshot(connect, 247),
  mark: await screenshot(mark, 440),
  reply: await screenshot(reply, 440),
};

const steps = [
  {
    title: t('Connect a tab'),
    // i18n: [connect] is a button in Stylebot's CLI mode terminal; use the extension's own translation.
    body: t(
      'Ask your agent to watch the page using Stylebot, then click <strong>[connect]</strong> on your tab.',
    ),
    command: '/stylebot watch',
    shot: shots.connect,
    alt: t(
      "Stylebot's terminal offering to connect the tab, with a [connect] button",
    ),
  },
  {
    title: t('Mark what to change'),
    body: t('Drag over the page to mark it, then type a note and press Enter.'),
    shot: shots.mark,
    alt: t("Stylebot's terminal with two marks and a note about them"),
  },
  {
    title: t('See each change'),
    // i18n: [undo] is a button in Stylebot's CLI mode terminal; use the extension's own translation.
    body: t(
      'The terminal shows what your agent did, with an <strong>[undo]</strong> for each save.',
    ),
    shot: shots.reply,
    alt: t(
      'The terminal showing the note, the commands the agent ran with an undo, and its answer',
    ),
  },
];
---

<Base
  title={t('Command line')}
  description={t(
    'Control Stylebot from your terminal, or let a coding agent like Claude Code, Codex or Cursor restyle sites in your browser on your own subscription.',
  )}
>
  <main class="cli">
    <div class="cli-intro">
      <h1>{t('Stylebot from your terminal')}</h1>
      <p>
        {t(
          'Let a coding agent like Claude Code, Codex or Cursor restyle sites right in your browser.',
        )}
      </p>
    </div>

    <section>
      <h2>{t('Set it up')}</h2>
      <ol class="cli-steps">
        <li>
          <h3>{t('Install Stylebot for Chrome or Edge')}</h3>
          <div class="cli-stores">
            <ButtonLink href={storeHref('chrome', 'cli')} variant="outline">
              {t('Add to {store}', { store: STORES.chrome.name })}
            </ButtonLink>
            <ButtonLink href={storeHref('edge', 'cli')} variant="outline">
              {t('Add to {store}', { store: STORES.edge.name })}
            </ButtonLink>
          </div>
        </li>
        <li>
          <h3>{t('Install the CLI and connect it')}</h3>
          <CliCommand lines={[CLI_INSTALL, 'stylebot install']} />
        </li>
        <li>
          <h3>{t('Turn on command line access')}</h3>
          <p
            set:html={rich(
              // i18n: "Basics" and "Allow command line access" are a section and a setting in Stylebot's Options page; use the extension's own translations.
              t(
                'Enable <strong>Basics › Allow command line access</strong> in Stylebot’s options.',
              ),
            )}
          />
        </li>
        <li>
          <h3>
            {t('Add the Stylebot skill to your agent')}{' '}
            <span class="cli-optional">{t('Optional')}</span>
          </h3>
          <p>{t('It teaches your agent to restyle pages with the CLI.')}</p>
          <CliTabs
            label={t('Your agent')}
            tabs={[
              ...AGENTS.map(({ id, name }) => ({ id, label: name })),
              { id: 'agent-other', label: t('Other agents') },
            ]}
          >
            {AGENTS.map(({ id, commands }) => (
              <div role="tabpanel" id={id} hidden={id !== AGENTS[0].id}>
                <CliCommand lines={commands} />
              </div>
            ))}
            <div role="tabpanel" id="agent-other" hidden>
              <p
                set:html={rich(
                  t(
                    'In Cursor, Copilot in VS Code or another agent, copy <a href="{skill}">the skill’s folder</a> into the agent’s skills folder, such as <code>~/.cursor/skills/</code>.',
                  ),
                  { skill: LINKS.skill },
                )}
              />
            </div>
          </CliTabs>
        </li>
      </ol>
    </section>

    <section>
      <h2>{t('Stylebot CLI mode')}</h2>
      <ol class="cli-steps">
        {steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p set:html={rich(step.body)} />

            {step.command && (
              <div class="cli-step-command">
                <p>{t('In Claude Code:')}</p>
                <CliCommand lines={[step.command]} />
              </div>
            )}

            <ZoomableImage
              client:visible
              class="cli-shot"
              strings={zoomStrings}
              {...step.shot}
              alt={step.alt}
            />
          </li>
        ))}
      </ol>

      <p>
        {t(
          'Or skip marking and just ask your agent for a look, such as “give Hacker News a dark theme”.',
        )}
      </p>
    </section>

    <section>
      <h2>{t('Privacy', { context: 'section' })}</h2>
      {[
        t(
          "Command line access is off until you turn it on. While it's on, apps on this computer can read your open pages, take screenshots and change your styles. Turn it off in Stylebot's options at any time.",
        ),
        t(
          'Stylebot and the CLI talk only to each other, on this computer, and send nothing anywhere. An agent sends what it reads to its own provider, as Claude Code does to Anthropic.',
        ),
      ].map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </section>
  </main>
</Base>

<style>
  .cli {
    max-width: var(--width-text);
    margin: 0 auto;
    padding: 64px var(--gutter) 0;
  }

  .cli-intro {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 36px;
  }

  h1 {
    margin: 0;
    font: 600 clamp(30px, 3.6vw, 40px) / 1.1 var(--font-display);
    letter-spacing: -0.025em;
    color: var(--fg);
    text-wrap: balance;
  }

  .cli-intro p {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  section {
    padding: 40px 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h2 {
    margin: 0 0 12px;
    font: 600 26px/1.2 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  h3 {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    font: 600 var(--text-base)/1.3 var(--font-ui);
    color: var(--fg);
  }

  p {
    margin: 0;
    font: 400 var(--text-base)/1.65 var(--font-ui);
    color: var(--fg-secondary);
    text-wrap: pretty;
  }

  p :global(code) {
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    background: var(--bg-muted);
    border: 1px solid var(--border);
    font: 500 0.88em/1.5 var(--font-mono);
    color: var(--fg);
  }

  .cli-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .cli-steps li {
    position: relative;
    padding-left: 42px;
    counter-increment: step;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cli-steps li::before {
    content: counter(step);
    position: absolute;
    top: -1px;
    left: 1px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--bg-badge);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 600 var(--text-xs)/1 var(--font-ui);
    color: var(--fg-secondary);
  }

  .cli-steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 30px;
    bottom: -34px;
    left: 12.5px;
    width: 1px;
    background: var(--border);
  }

  .cli-steps p {
    font-size: var(--text-base);
    color: var(--fg-muted);
  }

  .cli-steps p :global(strong) {
    font-weight: 600;
    color: var(--fg);
  }

  .cli-step-command {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cli-step-command p {
    font-size: var(--text-sm);
  }

  .cli-optional {
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    background: var(--bg-badge);
    font: 500 var(--text-xs)/1 var(--font-ui);
    color: var(--fg-muted);
  }

  .cli-stores {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  p :global(a) {
    color: var(--fg);
  }

  .cli-steps :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 760px) {
    .cli {
      padding-top: 40px;
    }
  }
</style>

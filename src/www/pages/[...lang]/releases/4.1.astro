---
import ButtonLink from '@/components/ButtonLink';
import Base from '@/layouts/Base.astro';

import GalleryMock from '@/www/components/GalleryMock.astro';
import PublishMock from '@/www/components/PublishMock.astro';

import { LINKS } from '@/lib/links';

import { localeStaticPaths } from '@/i18n';

export const getStaticPaths = localeStaticPaths;

const { t } = Astro.locals;
const title = t("What's new in {version}", { version: '4.1' });
---

<Base
  title={title}
  description={t(
    'Stylebot 4.1 adds the Gallery, where you can install styles for the sites you use and publish your own.',
  )}
>
  <main class="release">
    <div class="release-intro">
      <h1>{title}</h1>
      <p>{t('Stylebot now has a Gallery where you can share your styles.')}</p>
    </div>

    <div class="release-body">
      <section id="gallery" class="release-split">
        <div class="release-text">
          <h2>{t('Gallery')}</h2>
          <p>
            {t(
              'Open Stylebot on a site to see the styles people have published for it.',
            )}
          </p>
          <ul>
            {[
              t('Preview a style on the page before you install it'),
              t(
                'Installed styles update when their author publishes a new version, unless you’ve edited your copy',
              ),
            ].map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <div>
            <ButtonLink href={LINKS.gallery}>
              {t('Browse the Gallery →')}
            </ButtonLink>
          </div>
          <p class="release-note">
            {t('You can turn off Gallery suggestions in Options.')}
          </p>
        </div>
        <div class="release-mock" aria-hidden="true">
          <GalleryMock previewing />
        </div>
      </section>

      <hr />

      <section id="share" class="release-split">
        <div class="release-text">
          <h2>{t('Share your styles')}</h2>
          <p>
            {t(
              'The Gallery is new, so most sites don’t have styles yet. If you’ve hidden a site’s clutter, made it dark or fixed its fonts, someone else probably wants the same thing.',
            )}
          </p>
          <ul>
            {[
              t('Publish a style to the Gallery from the popup or the editor'),
              t(
                'Your edits stay on your computer until you publish an update, and everyone who installed your style gets it',
              ),
              t('Rename or delete your styles on the Gallery at any time'),
            ].map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div class="release-mock" aria-hidden="true">
          <PublishMock />
        </div>
      </section>

      <hr />

      <section id="more" class="release-more">
        <h2>{t('Other changes')}</h2>
        <ul>
          {[
            // i18n: "Basic" is a tab in Stylebot's editor; use the extension's own translation.
            t('Font weight in the editor’s Basic tab'),
            t(
              'Foldable blocks in the code editor, with the current selector pinned as you scroll, and a restyled search and color picker',
            ),
            t('Create, rename, edit and delete profiles from the popup'),
            t('Sync uses the right Google account and keeps you signed in'),
            t('Sites’ text styles no longer leak into Stylebot’s panels'),
            t('Closing the editor clears the selected element'),
          ].map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    </div>
  </main>
</Base>

<style>
  .release {
    max-width: 1080px;
    margin: 0 auto;
    padding: 64px var(--gutter) 0;
    color: var(--fg-secondary);
  }

  .release-intro {
    max-width: var(--width-text);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .release-intro h1 {
    margin: 0;
    font: 700 clamp(34px, 4.6vw, 48px) / 1.05 var(--font-display);
    letter-spacing: -0.035em;
    color: var(--fg);
    text-wrap: balance;
  }

  .release-intro p {
    margin: 0;
    font: 400 19px/1.55 var(--font-ui);
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  .release-body {
    margin-top: 56px;
    display: flex;
    flex-direction: column;
    gap: 72px;
  }

  .release-body hr {
    width: 100%;
    height: 1px;
    margin: 0;
    border: none;
    background: var(--border);
  }

  .release h2 {
    margin: 0;
    font: 650 clamp(24px, 2.6vw, 30px) / 1.15 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--fg);
    text-wrap: balance;
  }

  .release [id] {
    scroll-margin-top: 80px;
  }

  .release-split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }

  .release-text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .release-text p {
    margin: 0;
    max-width: 60ch;
    font: 400 17px/1.65 var(--font-ui);
    text-wrap: pretty;
  }

  .release .release-note {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--fg-muted);
  }

  .release ul {
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .release li {
    position: relative;
    padding-left: 17px;
    font: 400 var(--text-base)/1.55 var(--font-ui);
    text-wrap: pretty;
  }

  .release li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    width: 5px;
    height: 5px;
    border-radius: 3px;
    background: var(--accent);
  }

  .release-mock {
    min-height: 360px;
    padding: 28px;
    border-radius: var(--radius-xl);
    background: var(--bg-muted);
    border: 1px solid var(--border);
    display: grid;
    align-content: center;
    color: var(--fg);
  }

  .release-mock > :global([data-ed]) {
    color: var(--fg);
  }

  .release-mock :global(.mock-card) {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .release-more {
    max-width: var(--width-text);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .release-more > p {
    margin: 0;
    font: 400 17px/1.65 var(--font-ui);
    text-wrap: pretty;
  }
</style>

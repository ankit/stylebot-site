---
import Base from '@/layouts/Base.astro';

import GoodbyeFeedback from '@/www/components/GoodbyeFeedback';
import StoreLink from '@/components/StoreLink.astro';

import { localeStaticPaths } from '@/i18n';

export const getStaticPaths = localeStaticPaths;

const { lang, strings, t } = Astro.locals;
---

<Base
  title={t('Goodbye')}
  description={t('Thanks for using Stylebot.')}
  noindex
>
  <main class="gb">
    <h1>{t('Thanks for using Stylebot.')}</h1>
    <GoodbyeFeedback
      client:visible
      strings={strings('www/components/GoodbyeFeedback.tsx')}
      locale={lang}
    />
    <div class="gb-reinstall">
      <span>{t('Changed your mind?')}</span>
      <StoreLink index={0} format="reinstall" variant="outline" />
    </div>
  </main>
</Base>

<style is:global>
  .gb {
    max-width: 620px;
    margin: 0 auto;
    padding: 56px var(--gutter) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
  }

  .gb h1 {
    margin: 14px 0 0;
    font: 700 var(--text-2xl) / 1.1 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--fg);
    text-wrap: balance;
  }

  .gb-reinstall {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px 16px;
    margin-top: 6px;
    font: 400 var(--text-sm)/1.4 var(--font-ui);
    color: var(--fg-muted);
  }

  .gb-reinstall .btn {
    padding: 10px 16px;
    font-size: var(--text-sm);
  }
</style>

---
import CloseIcon from '@/components/icons/CloseIcon';

const { t } = Astro.locals;
---

<dialog class="zoom" aria-label={t('Enlarged screenshot')}>
  <img class="zoom-img" alt="" />
  <button class="zoom-close" aria-label={t('Close')}>
    <CloseIcon strokeWidth={1.6} />
  </button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.zoom')!;
  const zoomed = dialog.querySelector<HTMLImageElement>('.zoom-img')!;

  /**
   * The sharpest source the image offers: its last `srcset` candidate, which
   * Astro lists from 1x up.
   */
  function largest(img: HTMLImageElement) {
    const last = img.srcset.split(',').pop()?.trim().split(/\s+/)[0];

    return last || img.currentSrc || img.src;
  }

  /**
   * Caps the zoomed image at the file's own pixel size on this screen, so a
   * retina display never stretches it.
   */
  function fit(img: HTMLImageElement) {
    const width = Number(img.dataset.fullWidth) / devicePixelRatio;

    zoomed.style.maxWidth = width ? `min(1400px, 100%, ${width}px)` : '';
  }

  function open(img: HTMLImageElement) {
    zoomed.src = img.dataset.full || largest(img);
    fit(img);
    zoomed.alt = img.alt;
    dialog.showModal();
  }

  document
    .querySelectorAll<HTMLImageElement>('img.shot-image')
    .forEach((img) => {
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      img.addEventListener('click', () => open(img));
      img.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') {
          return;
        }

        e.preventDefault();
        open(img);
      });
    });

  dialog.addEventListener('click', () => dialog.close());
</script>

<style>
  :global(img.shot-image) {
    cursor: zoom-in;
  }

  .zoom {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 40px;
    border: none;
    background: transparent;
    cursor: zoom-out;
  }

  .zoom[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .zoom::backdrop {
    background: rgba(12, 13, 16, 0.82);
    backdrop-filter: blur(6px);
  }

  .zoom-img {
    max-width: min(1400px, 100%);
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--radius-md);
    filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.5));
  }

  .zoom-close {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    border: none;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .zoom-close:hover {
    background: rgba(255, 255, 255, 0.24);
  }

  @media (max-width: 600px) {
    .zoom {
      padding: 16px;
    }
  }
</style>

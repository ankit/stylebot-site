---
import type { ImageMetadata } from 'astro';

import ZoomableImage from '@/components/ZoomableImage';

import { screenshot } from '@/www/lib/screenshots';

type Props = { label: string; src: ImageMetadata; dark?: ImageMetadata };
const { label, src, dark } = Astro.props;
const { strings } = Astro.locals;

// The manual's column width, so 2x screens don't shrink the image and blur its text.
const COLUMN_WIDTH = 720;
const widthOf = (image: ImageMetadata) =>
  Math.min(image.width / 2, COLUMN_WIDTH);
const zoomStrings = strings('components/ZoomableImage.tsx');
const lightShot = await screenshot(src, widthOf(src));
let darkShot;

if (dark) {
  darkShot = await screenshot(dark, widthOf(dark));
}
---

<ZoomableImage
  client:visible
  class:list={['shot-image', { 'is-light': dark }]}
  alt={label}
  strings={zoomStrings}
  {...lightShot}
/>
{darkShot && (
  <ZoomableImage
    client:visible
    class="shot-image is-dark"
    alt={label}
    strings={zoomStrings}
    {...darkShot}
  />
)}

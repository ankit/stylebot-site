---
import { Image } from 'astro:assets';

import CheckIcon from '@/components/icons/CheckIcon';
import DownloadIcon from '@/components/icons/DownloadIcon';

import parchment from '@/assets/gallery/wikipedia/parchment.png';
import slate from '@/assets/gallery/wikipedia/slate.png';

const { locale, t } = Astro.locals;

const installs = new Intl.NumberFormat(locale, {
  notation: 'compact',
}).format(1240);
---

<div data-ed class="mock-card pop">
  <div class="pop-head">
    <b>en.wikipedia.org</b>
    <svg
      viewBox="0 0 24 24"
      width="15"
      height="15"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="3" />
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
    </svg>
  </div>

  <div class="pop-option">
    <b>{t('No style')}</b>
    <CheckIcon />
  </div>

  <div class="pop-gallery">
    <div class="pop-heading">
      <span>{t('Popular in Gallery')}</span>
      <span>{t('Browse all')}</span>
    </div>

    <div class="pop-preview">
      <span class="pop-summary">
        <Image src={parchment} width={160} alt="" class="pop-thumb" />
        <span class="pop-text">
          <span class="pop-name">Parchment &amp; Ink</span>
          <span class="pop-meta">{t('Preview · not installed')}</span>
        </span>
      </span>
      <span class="pop-buttons">
        <span class="pop-cancel">{t('Cancel')}</span>
        <span class="pop-install">{t('Install')}</span>
      </span>
    </div>

    <div class="pop-suggestion">
      <span class="pop-summary">
        <Image src={slate} width={160} alt="" class="pop-thumb" />
        <span class="pop-text">
          <span class="pop-name">Slate &amp; Ash</span>
          <span class="pop-meta">
            ankit
            <span class="pop-installs">
              <DownloadIcon size={11} />
              {installs}
            </span>
          </span>
        </span>
      </span>
    </div>
  </div>

  <div class="pop-action">
    <span class="pop-button">{t('Style this page')}</span>
  </div>
</div>

<style>
  .pop {
    width: min(100%, 300px);
    justify-self: center;
    font: 400 13px/1.2 var(--font-ui);
  }

  .pop-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    border-bottom: 1px solid var(--border);
    color: var(--fg-muted);
  }

  .pop-head b {
    font-size: 14px;
    font-weight: 600;
    color: var(--fg);
  }

  .pop-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    border-bottom: 1px solid var(--border);
    color: var(--fg-subtle);
  }

  .pop-option b {
    font-weight: 600;
    color: var(--fg);
  }

  .pop-action {
    padding: 12px;
    border-top: 1px solid var(--border);
  }

  .pop-button {
    display: block;
    padding: 8px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    text-align: center;
    font-weight: 600;
  }

  .pop-gallery {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 8px 8px;
  }

  .pop-heading {
    display: flex;
    justify-content: space-between;
    padding: 0 6px;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--fg-muted);
  }

  .pop-preview {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-muted);
  }

  .pop-suggestion {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px;
  }

  .pop-summary {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .pop-thumb {
    flex: none;
    width: 52px;
    height: 32px;
    object-fit: cover;
    object-position: top left;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .pop-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .pop-name {
    font-weight: 500;
    color: var(--fg);
  }

  .pop-meta {
    display: flex;
    gap: 8px;
    white-space: nowrap;
    font-size: 11.5px;
    color: var(--fg-muted);
  }

  .pop-installs {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }

  .pop-buttons {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
  }

  .pop-cancel,
  .pop-install {
    padding: 6px 12px;
    border-radius: 6px;
  }

  .pop-cancel {
    color: var(--fg);
  }

  .pop-install {
    border: 1px solid var(--border-strong);
    background: var(--bg-surface);
    color: var(--fg);
  }
</style>

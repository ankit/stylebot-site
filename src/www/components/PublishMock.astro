---
const { t } = Astro.locals;
---

<div data-ed class="mock-card pub">
  <div class="pub-head">
    <b>news.ycombinator.com</b>
  </div>

  <div class="pub-styles">
    <span class="pub-row">{t('No style')}</span>

    <div class="pub-row pub-active">
      <span>HN Terminal</span>
      <span class="pub-more">⋯</span>
    </div>

    <span class="pub-row">Daily HN Edition</span>

    <span class="pub-row pub-muted">{t('Create profile')}</span>

    <div class="pub-menu">
      <span>{t('Edit')}</span>
      <span>{t('Rename')}</span>
      <span class="pub-highlight">
        {t('Publish to Gallery')}
        <svg class="pub-cursor" width="18" height="22" viewBox="0 0 18 22">
          <path
            d="M1 1 L1 17 L5.5 13 L8.5 20 L11.5 18.8 L8.6 12 L14.5 12 Z"
            fill="#191b1f"
            stroke="#fff"
            stroke-width="1.4"
            stroke-linejoin="round"
          />
        </svg>
      </span>
      <hr />
      <span>{t('Delete')}</span>
    </div>
  </div>
</div>

<style>
  .pub {
    width: min(100%, 300px);
    justify-self: center;
    font: 400 14px/1.2 var(--font-ui);
  }

  .pub-head {
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
  }

  .pub-head b {
    font-weight: 600;
    color: var(--fg);
  }

  .pub-styles {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: 250px;
    padding: 8px 6px 10px;
  }

  .pub-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 36px;
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--fg);
  }

  .pub-active {
    background: var(--bg-muted);
    font-weight: 600;
  }

  .pub-more {
    color: var(--fg-muted);
    font-weight: 700;
  }

  .pub-muted {
    color: var(--fg-muted);
  }

  .pub-menu {
    position: absolute;
    top: 78px;
    right: 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 170px;
    padding: 5px;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: var(--bg-surface);
    box-shadow: var(--shadow-card);
  }

  .pub-menu span {
    padding: 8px 10px;
    border-radius: 6px;
    color: var(--fg);
  }

  .pub-menu .pub-highlight {
    position: relative;
    background: var(--bg-track);
  }

  .pub-cursor {
    position: absolute;
    top: 55%;
    right: 14px;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.25));
  }

  .pub-menu hr {
    width: 100%;
    height: 1px;
    margin: 2px 0;
    border: none;
    background: var(--border);
  }
</style>

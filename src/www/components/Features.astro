---
import CarouselNav from './CarouselNav.astro';
import GalleryMock from './GalleryMock.astro';
import HistoryMock from './HistoryMock.astro';
import SyncMock from './SyncMock.astro';

const { t } = Astro.locals;
---

<section id="features" class="section features">
  <div class="section-inner">
    <div class="section-head">
      <h2 class="section-title" style="max-width:22ch">
        {t('Everything else you get.')}
      </h2>
      <CarouselNav
        target="features-track"
        previous={t('Previous feature')}
        next={t('Next feature')}
      />
    </div>
    <div id="features-track" class="carousel features-track">
      <article class="feature">
        <div class="feature-mock" aria-hidden="true">
          <GalleryMock />
        </div>
        <div class="feature-text">
          <h3>{t('Gallery')}</h3>
          <p>
            {t(
              'Open Stylebot on a site and it suggests popular styles from the Gallery. Preview one on the page, then install it. Made one you like? Publish it from its ⋯ menu in the popup or the editor.',
            )}
          </p>
        </div>
      </article>

      <article class="feature">
        <div class="feature-mock" aria-hidden="true">
          <SyncMock />
        </div>
        <div class="feature-text">
          <h3>{t('Sync')}</h3>
          <p>
            {t(
              'Connect Google Drive and your styles follow you to every computer you sign in to. Stylebot syncs every 30 minutes and right after you edit.',
            )}
          </p>
        </div>
      </article>

      <article class="feature">
        <div class="feature-mock" aria-hidden="true">
          <HistoryMock />
        </div>
        <div class="feature-text">
          <h3>{t('Version history')}</h3>
          <p>
            {t(
              'Every change to your styles is kept, newest first. Open an entry to see what changed and restore it in one click.',
            )}
          </p>
        </div>
      </article>

      <article class="feature">
        <div class="feature-mock" aria-hidden="true">
          <div data-ed class="preset-list">
            <div class="mock-card preset">
              <div class="preset-head">
                <span class="mock-title">{t('Readability')}</span>
                <span class="switch on">
                  <span />
                </span>
                <span class="preset-note">{t('Articles only')}</span>
              </div>
              <div class="preset-body">
                {t(
                  'A clean reading view, with your choice of theme, font, and size.',
                )}
              </div>
            </div>
            <div class="mock-card preset">
              <div class="preset-head">
                <span class="mock-title">{t('Grayscale')}</span>
                <span class="switch">
                  <span />
                </span>
              </div>
              <div class="preset-body">{t('Apply grayscale to the page.')}</div>
            </div>
          </div>
        </div>
        <div class="feature-text">
          <h3>{t('Presets')}</h3>
          <p>
            {t(
              'Readability and grayscale work on any site, and they stack with your own changes.',
            )}
          </p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .carousel {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: grab;
  }

  .carousel:focus-visible {
    border-radius: var(--radius-lg);
  }

  .carousel.is-dragging,
  .carousel.is-dragging * {
    cursor: grabbing;
    user-select: none;
  }

  .carousel::-webkit-scrollbar {
    display: none;
  }

  .features {
    background: var(--bg-surface);
  }

  .features-track {
    padding-bottom: 4px;
  }

  .feature {
    flex: 0 0 min(440px, 86%);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .feature-text {
    min-width: 0;
    padding: 0 4px;
  }

  .feature-text h3 {
    font: 600 20px/1.25 var(--font-display);
    letter-spacing: -0.015em;
    margin: 0 0 8px;
    color: var(--fg);
  }

  .feature-text p {
    font: 400 var(--text-base)/1.6 var(--font-ui);
    color: var(--fg-muted);
    margin: 0;
    max-width: 44ch;
    text-wrap: pretty;
  }

  .feature-mock {
    height: 400px;
    border-radius: 16px;
    background: var(--bg-muted);
    border: 1px solid var(--border);
    display: grid;
    align-content: center;
    padding: 24px;
    overflow: hidden;
    color: var(--fg);
    font: 400 12.5px/1.4 var(--font-ui);
  }

  .feature-mock > :global([data-ed]) {
    --accent: #276cd8;

    color: var(--fg);
  }

  :global(:root:is([data-theme='dark'], [data-theme='late-edition']))
    .feature-mock
    > :global([data-ed]) {
    --accent: #80a4e1;
  }

  .feature-mock :global(.mock-card) {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .mock-title {
    font: 600 14px/1.25 var(--font-ui);
    color: var(--fg);
  }

  .acc {
    color: var(--accent);
  }

  .preset-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .preset {
    padding: 14px 16px;
  }

  .preset-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .preset-note {
    margin-left: auto;
    font: 400 12px/1 var(--font-ui);
    color: var(--fg-muted);
  }

  .preset-body {
    margin-top: 8px;
    color: var(--fg-muted);
    line-height: 1.5;
  }

  .switch {
    width: 36px;
    height: 20px;
    border-radius: 10px;
    flex: none;
    position: relative;
    background: var(--border-strong);
  }

  .switch > span {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
  }

  .switch.on {
    background: var(--accent);
  }

  .switch.on > span {
    left: 18px;
  }

  @media (max-width: 639px) {
    .feature {
      flex-basis: min(440px, 90%);
    }

    .feature-mock {
      height: auto;
      min-height: 360px;
      padding: 12px;
    }
  }
</style>

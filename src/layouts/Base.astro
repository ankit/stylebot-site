---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

import { ThemeHead } from '@/theme';

import { DEFAULT_LOCALE, LOCALES, localizePath, unlocalizedPath } from '@/i18n';

import appleTouchIcon from '@/assets/brand/apple-touch-icon.png?url&no-inline';
import faviconIco from '@/assets/brand/favicon.ico?url&no-inline';
import faviconSvg from '@/assets/brand/favicon.svg?url&no-inline';
import ogImage from '@/assets/brand/og.png?url&no-inline';

import '@/styles/global.css';

type Props = {
  title?: string;
  description?: string;
  footer?: boolean;
  current?: 'manual';
  storeCta?: boolean;
  install?: boolean;
  noindex?: boolean;
  alternates?: boolean;
  // The whole <title>, for pages that word it differently.
  fullTitle?: string;
};

const { lang, locale, t } = Astro.locals;

const {
  title,
  fullTitle,
  description = t(
    'Point at something on a page and change it. Stylebot writes the CSS and loads it every time you come back. Free and open source for Chrome, Firefox and Edge.',
  ),
  footer = true,
  current,
  storeCta,
  install,
  noindex,
  alternates = true,
} = Astro.props;

let pageTitle = t('Stylebot - Restyle any website');

if (fullTitle) {
  pageTitle = fullTitle;
} else if (title) {
  pageTitle = t('{title} - Stylebot', { title });
}

const canonical = new URL(Astro.url.pathname, Astro.site);
const path = unlocalizedPath(Astro.url.pathname);
const altUrl = (code: (typeof LOCALES)[number]['code']) =>
  new URL(localizePath(code, path), Astro.site);
---

<!doctype html>
<html lang={lang} translate={locale === DEFAULT_LOCALE ? undefined : 'no'}>
  <head>
    <meta charset="utf-8" />
    {locale !== DEFAULT_LOCALE && <meta name="google" content="notranslate" />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {alternates &&
      LOCALES.map((l) => (
        <link rel="alternate" hreflang={l.lang} href={altUrl(l.code)} />
      ))}
    {alternates && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={altUrl(DEFAULT_LOCALE)}
      />
    )}
    <meta name="theme-color" content="#f7f8fa" />
    <link rel="icon" href={faviconIco} sizes="48x48" />
    <link rel="icon" href={faviconSvg} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={appleTouchIcon} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Stylebot" />
    <meta property="og:locale" content={lang.replace('-', '_')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={t('Stylebot - Restyle any website')}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@stylebot" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <slot name="head" />
    <ThemeHead />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=Gabarito:wght@600;700;800&family=Newsreader:opsz,wght@6..72,400;6..72,600;6..72,700&family=Lora:ital,wght@0,400;0,700;1,500&family=Public+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    {import.meta.env.PROD && (
      <>
        <script
          is:inline
          async
          src="https://plausible.io/js/pa-BGI4Ew6K-t0hsxPyst1zG.js"
        />
        <script is:inline>
          window.plausible =
            window.plausible ||
            function () {
              // Plausible's own snippet, which queues calls as they were made.
              // eslint-disable-next-line prefer-rest-params
              (plausible.q = plausible.q || []).push(arguments);
            };

          plausible.init =
            plausible.init ||
            function (i) {
              plausible.o = i || {};
            };

          plausible.init({ outboundLinks: true });
        </script>
      </>
    )}
  </head>
  <body>
    {Astro.slots.has('header') ? (
      <slot name="header" />
    ) : (
      <Header current={current} storeCta={storeCta} install={install} />
    )}
    <slot />
    {footer && (
      <div class="container">
        <Footer />
      </div>
    )}
  </body>
</html>

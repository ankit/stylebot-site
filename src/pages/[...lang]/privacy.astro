---
import Base from '@/layouts/Base.astro';

import { DEFAULT_LOCALE, localeStaticPaths, rich } from '@/i18n';

export const getStaticPaths = localeStaticPaths;

const { lang, locale, t } = Astro.locals;

const updated = new Intl.DateTimeFormat(lang, {
  dateStyle: 'long',
  timeZone: 'UTC',
}).format(Date.UTC(2026, 9, 12));

const sections = [
  {
    title: t('In your browser'),
    body: [
      t(
        "Your styles, settings and history are saved in your browser, and uninstalling Stylebot removes them. Google Fonts and stylesheets you <code>@import</code> are downloaded from where they're hosted, which sees your IP address.",
      ),
    ],
  },
  {
    title: t('Google Drive sync'),
    body: [
      t(
        'Connecting Google Drive in Options saves your styles to a file in your own Drive. Stylebot can only see files it creates, and its access token stays in your browser. Disconnect in Options or in your <a href="https://myaccount.google.com/connections">Google account</a>.',
      ),
      t(
        'Stylebot\'s use of information received from Google APIs adheres to the <a href="https://developers.google.com/terms/api-services-user-data-policy">Google API Services User Data Policy</a>, including the Limited Use requirements.',
      ),
    ],
  },
  {
    title: t('Command line'),
    body: [
      t(
        "Turning on <q>Allow command line access</q> in Options lets apps running as you read your tabs, pages and styles, take screenshots and change your styles, over a local connection. What they read can reach the services they use, such as a coding agent's model.",
      ),
    ],
  },
  {
    title: t('This website'),
    body: [
      t(
        'stylebot.dev has no ads or cookies. GitHub Pages hosts it and keeps server logs, and Plausible counts visits and clicks without identifying you.',
      ),
    ],
  },
];
---

<Base
  title={t('Privacy', { context: 'page' })}
  description={t(
    'What Stylebot does with your data: no server, no account, no analytics.',
  )}
>
  <main class="privacy">
    <div class="privacy-intro">
      <h1>{t('Privacy', { context: 'page' })}</h1>
      <p>
        {t(
          "Stylebot has no server, no account and no analytics, and doesn't collect, sell or share your data. It only leaves your browser when you use one of the features below.",
        )}
      </p>
      <p class="updated">{t('Last updated {date}', { date: updated })}</p>
      {locale !== DEFAULT_LOCALE && (
        <p
          class="translated"
          set:html={rich(
            t(
              'This is a translation. If it differs from the <a href="{original}">English version</a>, the English version applies.',
            ),
            { original: '/privacy' },
          )}
        />
      )}
    </div>

    {sections.map((section) => (
      <section>
        <h2>{section.title}</h2>
        {section.body.map((paragraph) => (
          <p set:html={rich(paragraph)} />
        ))}
      </section>
    ))}
  </main>
</Base>

<style>
  .privacy {
    max-width: 720px;
    margin: 0 auto;
    padding: 64px var(--gutter) 0;
  }

  .privacy-intro {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 36px;
  }

  h1 {
    margin: 0;
    font: 700 clamp(34px, 4.6vw, 48px) / 1.05 var(--display);
    letter-spacing: -0.03em;
    color: var(--ink);
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .privacy-intro p {
    font-size: 18px;
    line-height: 1.55;
    color: var(--muted);
  }

  .privacy-intro .updated,
  .privacy-intro .translated {
    font-size: 14px;
    color: var(--faint);
  }

  section {
    padding: 40px 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h2 {
    margin: 0;
    font: 700 26px/1.2 var(--display);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  p {
    margin: 0;
    font: 400 16px/1.65 var(--ui);
    color: var(--ink2);
    text-wrap: pretty;
  }

  p :global(code) {
    padding: 1px 6px;
    border-radius: 5px;
    background: var(--fill);
    border: 1px solid var(--border);
    font: 400 0.88em/1.5 var(--mono);
  }

  @media (max-width: 760px) {
    .privacy {
      padding-top: 40px;
    }
  }
</style>

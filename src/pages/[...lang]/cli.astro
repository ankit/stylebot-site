---
import Base from '@/layouts/Base.astro';

import CliCommand from '@/components/cli/CliCommand.astro';

import { CLI_EXAMPLES, CLI_INSTALL } from '@/lib/cli';
import { STORES } from '@/lib/links';

import { localeStaticPaths, rich } from '@/i18n';

export const getStaticPaths = localeStaticPaths;

const { t } = Astro.locals;

const examples = CLI_EXAMPLES.map(({ id, command }) => [
  command,
  {
    open: t('Opens the page in a window behind yours and prints its tab id.'),
    outline: t('Prints the page’s visible elements as an outline.'),
    css: t(
      'Saves the CSS as the site’s style, applies it, and checks the page.',
    ),
    screenshot: t('Saves a picture of the tab.'),
  }[id],
]);
---

<Base
  title={t('Command line')}
  description={t(
    'Control Stylebot from your terminal, or let a coding agent like Claude Code, Codex or Cursor restyle sites in your browser on your own subscription.',
  )}
>
  <main class="cli">
    <div class="cli-intro">
      <h1>{t('Stylebot from your terminal')}</h1>
      <p>
        {t(
          'Control Stylebot from the command line, or let a coding agent like Claude Code, Codex or Cursor do it. The agent restyles sites right in your browser, using your own subscription instead of an API key.',
        )}
      </p>
    </div>

    <section>
      <h2>{t('Set it up')}</h2>
      <ol class="cli-steps">
        <li>
          <h3>{t('Install Stylebot', { context: 'step' })}</h3>
          <p>
            {t(
              "For Chrome or Edge. The command line doesn't work on Firefox yet.",
            )}
          </p>
          <div class="cli-stores">
            <a href={STORES.chrome.href} class="btn btn-outline">
              {t('Add to {store}', { store: STORES.chrome.name })}
            </a>
            <a href={STORES.edge.href} class="btn btn-outline">
              {t('Add to {store}', { store: STORES.edge.name })}
            </a>
          </div>
        </li>
        <li>
          <h3>{t('Install the CLI')}</h3>
          <p>{t('It needs Node 20 or later.')}</p>
          <CliCommand lines={[CLI_INSTALL]} />
        </li>
        <li>
          <h3>{t('Connect it to your browsers')}</h3>
          <p>
            {t(
              'This registers the CLI with Chrome and Edge, so Stylebot can reach it.',
            )}
          </p>
          <CliCommand lines={['stylebot install']} />
        </li>
        <li>
          <h3>{t('Turn on command line access')}</h3>
          <p
            set:html={rich(
              // i18n: "Basics" and the bolded setting are labels in Stylebot's Options page; use the extension's own translation.
              t(
                "In Stylebot's options, under Basics, turn on <strong>Allow command line access</strong> and allow what the browser asks for.",
              ),
            )}
          />
        </li>
        <li>
          <h3>
            {t('Add the Claude Code plugin')}{' '}
            <span class="cli-optional">{t('Optional')}</span>
          </h3>
          <p>{t('In Claude Code, run:')}</p>
          <CliCommand lines={['/plugin marketplace add ankit/stylebot']} />
          <CliCommand lines={['/plugin install stylebot@stylebot']} />
          <p>{t('Then try it:')}</p>
          <CliCommand
            lines={['/stylebot news.ycombinator.com give it a dark theme']}
          />
        </li>
      </ol>
    </section>

    <section>
      <h2>{t('Commands')}</h2>
      <p
        set:html={rich(
          t(
            'An agent runs these for you, but you can run them yourself too. <code>stylebot --help</code> lists them all.',
          ),
        )}
      />
      <dl class="cli-examples">
        {examples.map(([command, what]) => (
          <div>
            <dt>
              <CliCommand lines={[command]} copy={false} />
            </dt>
            <dd>{what}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section>
      <h2>{t('Privacy', { context: 'section' })}</h2>
      {[
        t(
          "Command line access is off until you turn it on. While it's on, apps on this computer can read your open pages, take screenshots and change your styles. Turn it off in Stylebot's options at any time.",
        ),
        t(
          'Stylebot and the CLI talk only to each other, on this computer, and send nothing anywhere. An agent sends what it reads to its own provider, as Claude Code does to Anthropic.',
        ),
      ].map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </section>
  </main>
</Base>

<style>
  .cli {
    max-width: var(--width-text);
    margin: 0 auto;
    padding: 64px var(--gutter) 0;
  }

  .cli-intro {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 36px;
  }

  h1 {
    margin: 0;
    font: 700 var(--text-3xl) / 1.05 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--fg);
    text-wrap: balance;
  }

  .cli-intro p {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  section {
    padding: 40px 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h2 {
    margin: 0;
    font: 700 var(--text-xl)/1.2 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  h3 {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    font: 600 var(--text-base)/1.3 var(--font-ui);
    color: var(--fg);
  }

  p {
    margin: 0;
    font: 400 var(--text-base)/1.65 var(--font-ui);
    color: var(--fg-secondary);
    text-wrap: pretty;
  }

  p :global(code) {
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    background: var(--bg-muted);
    border: 1px solid var(--border);
    font: 400 0.88em/1.5 var(--font-mono);
  }

  .cli-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .cli-steps li {
    position: relative;
    padding-left: 38px;
    counter-increment: step;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cli-steps li::before {
    content: counter(step);
    position: absolute;
    top: -1px;
    left: 0;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    border: 1px solid var(--border-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 600 var(--text-xs)/1 var(--font-ui);
    color: var(--fg);
  }

  .cli-steps p {
    font-size: var(--text-base);
    color: var(--fg-muted);
  }

  .cli-steps p :global(strong) {
    font-weight: 600;
    color: var(--fg);
  }

  .cli-optional {
    padding: 3px 7px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    font: 500 var(--text-xs)/1 var(--font-ui);
    color: var(--fg-muted);
  }

  .cli-stores {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .cli-examples {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .cli-examples dt {
    min-width: 0;
  }

  .cli-examples dd {
    margin: 8px 0 0 12px;
    font: 400 var(--text-sm)/1.5 var(--font-ui);
    color: var(--fg-muted);
  }

  @media (max-width: 760px) {
    .cli {
      padding-top: 40px;
    }
  }
</style>

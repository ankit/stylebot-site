{
  "name": "@stylebot/site",
  "private": true,
  "description": "Stylebot landing page",
  "version": "0.2.0",
  "author": "Ankit Ahuja",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:gallery": "astro dev --config astro.gallery.config.mjs",
    "build": "astro build",
    "build:gallery": "astro build --config astro.gallery.config.mjs",
    "preview": "astro preview",
    "preview:gallery": "astro preview --config astro.gallery.config.mjs",
    "check": "astro check && node scripts/check-messages.ts && node scripts/extension-terms.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "deploy": "astro build && gh-pages -d dist -b gh-pages -t",
    "extract:messages": "node scripts/extract-messages.ts",
    "sync:extension-strings": "node scripts/sync-extension-strings.ts"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6",
    "typescript-eslint": "^8.71.2"
  }
}
